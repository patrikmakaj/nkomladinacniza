---
/**
 * TV prikaz pikado turnira — /turnir/pikado/tv
 *
 * Za veliki ekran u Društvenom domu: grupe s ljestvicama, „Igra se" (mečevi
 * označeni na Challongeu kao in progress), „Na redu" / „Iduće" i QR za praćenje
 * na mobitelu. Kad grupe završe, umjesto njih ide kostur eliminacije, a na
 * kraju postolje s nagradama.
 *
 * Podaci se čitaju uživo iz preglednika preko posrednika (Cloudflare Worker,
 * `scripts/cloudflare/pikado-tv-proxy.js`, adresa u `config.tvApi`). Izravno s
 * Challonge API-ja ne ide: preflight dopusti CORS, ali GET odgovor nema
 * `Access-Control-Allow-Origin`, pa ga preglednik odbije. Worker drži tajne i
 * 30 s cache. Rezervni put bez Workera: token u adresi (`…/tv#t=<token>`) u
 * pregledniku pokrenutom bez CORS provjere — samo za nuždu.
 *
 * Limit besplatne Challonge aplikacije je 500 zahtjeva mjesečno — osvježavanje
 * svakih 60 s troši ~60 zahtjeva na sat.
 *
 * Grupe: Challonge u v2.1 ne vraća pouzdano kojoj grupi meč pripada, pa se
 * grupe izvode iz samih mečeva grupne faze (svatko sa svakim → svaka grupa je
 * zasebna povezana cjelina), a slova A, B, C… idu po najboljem nositelju.
 */
import QRCode from "qrcode";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { url } from "../../../lib/url";
import config from "../../../config/pikado.json";

// Isto kao na /turnir/pikado — kotizacija i udjeli nagrada.
const FEE = 15;
const PRIZES = [0.5, 0.3, 0.1];
const TITLE = "2. pikado turnir";

const site = Astro.site ?? new URL("https://omladinacniza.hr");
const pageUrl = new URL(url("/turnir/pikado"), site).href;
const qrSvg = await QRCode.toString(pageUrl, {
  type: "svg",
  margin: 0,
  color: { dark: "#0f2c6e", light: "#0000" },
});
const shortUrl = pageUrl.replace(/^https?:\/\//, "").replace(/\/$/, "");

// Posrednik (Cloudflare Worker, scripts/cloudflare/pikado-tv-proxy.js). Bez njega
// preglednik ne može čitati Challonge API (vidi komentar u Workeru).
const tvApi = (config as { tvApi?: string }).tvApi?.trim() || "";
const payload = { slug: config.tournament, fee: FEE, prizes: PRIZES, tvApi };
---

<BaseLayout title={`${TITLE} — TV`} description="TV prikaz rezultata pikado turnira." noIndex bare>
  <script type="application/json" id="tv-config" set:html={JSON.stringify(payload)} />

  <div id="tv-stage">
    <div id="tv">
      <header class="tv-top">
        <img src={url("/images/dsa-niza.png")} alt="DŠA Niza" />
        <div class="ttl">
          <span class="pill"><i></i><span id="tv-phase">Učitavam…</span></span>
          <h1>{TITLE}</h1>
          <p>DŠA Niza · Društveni dom u Nizi · 501 double out</p>
        </div>
        <div class="stat"><b id="tv-fund">—</b><small>nagradni fond</small></div>
        <div class="stat"><b id="tv-clock">--:--</b><small id="tv-date">&nbsp;</small></div>
      </header>

      <div id="tv-notice" class="notice" hidden><span>📢</span><p id="tv-notice-text"></p></div>

      <main class="tv-main">
        <section class="card col">
          <div id="tv-queue" class="queue"></div>
          <div class="qr">
            <Fragment set:html={qrSvg} />
            <p><b>Prati na mobitelu</b>{shortUrl}</p>
          </div>
        </section>
        <section id="tv-board" class="board"></section>
      </main>

      <div id="tv-toast" class="toast" hidden></div>

      <footer class="tv-foot">
        <span id="tv-note"></span>
        <span id="tv-status"></span>
      </footer>

      <div id="tv-setup" class="setup" hidden>
        <div>
          <h2>TV prikaz nije spojen na Challonge</h2>
          <p>Upiši adresu posrednika (Cloudflare Worker) u <code>src/config/pikado.json</code> → <code>tvApi</code>.
          Upute su u <code>scripts/cloudflare/pikado-tv-proxy.js</code>.</p>
          <p id="tv-setup-detail"></p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Ekran je složen za 1920×1080 i skalira se na stvarnu veličinu (vidi skriptu). */
  body:has(#tv-stage) { background: #0f2c6e; overflow: hidden; }
  #tv-stage { position: fixed; inset: 0; overflow: hidden; }
  #tv {
    width: 1920px; height: 1080px; transform-origin: 0 0; position: absolute;
    display: flex; flex-direction: column; background: #eef3fa; color: #0f172a;
    font-family: var(--font-sans);
  }
  #tv .tv-top { display: flex; align-items: center; gap: 26px; padding: 16px 40px; background: #0f2c6e; color: #fff; border-bottom: 5px solid #d4b659; }
  #tv .tv-top img { height: 120px; margin: -6px 0; filter: drop-shadow(0 4px 10px rgba(0,0,0,.35)); }
  #tv .ttl { flex: 1; }
  #tv .pill { font-family: var(--font-display); font-size: 19px; letter-spacing: .15em; text-transform: uppercase; background: #d4b659; color: #0f2c6e; padding: 4px 12px; border-radius: 4px; display: inline-flex; gap: 9px; align-items: center; }
  #tv .pill i { width: 11px; height: 11px; border-radius: 50%; background: #CF2130; }
  #tv h1 { font-size: 54px; line-height: 1.05; margin-top: 6px; color: #fff; }
  #tv .ttl p { font-size: 21px; color: rgba(255,255,255,.8); }
  #tv .stat { text-align: right; margin-left: 30px; }
  #tv .stat b { display: block; font-family: var(--font-display); font-size: 50px; line-height: 1; color: #d4b659; }
  #tv .stat small { font-size: 15px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.7); }

  #tv .tv-main { flex: 1; min-height: 0; padding: 22px 40px; display: grid; grid-template-columns: 600px 1fr; gap: 22px; }
  #tv .card { background: #fff; border-radius: 14px; box-shadow: 0 4px 18px rgba(15,44,110,.10); border: 1px solid #dbe4f3; overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
  #tv .h { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .08em; font-size: 25px; padding: 9px 18px; background: #0f2c6e; color: #fff; display: flex; justify-content: space-between; align-items: baseline; }
  #tv .h small { font-family: var(--font-sans); font-size: 15px; letter-spacing: 0; text-transform: none; opacity: .75; }

  #tv .queue { flex: 1; min-height: 0; overflow: hidden; padding-bottom: 6px; }
  #tv .mc { margin: 10px 14px 0; border-radius: 12px; border: 2px solid #dbe4f3; padding: 10px 14px; display: flex; gap: 14px; align-items: center; }
  #tv .mc .tag { font-family: var(--font-display); font-size: 17px; letter-spacing: .08em; text-transform: uppercase; width: 92px; padding: 8px 0; border-radius: 8px; text-align: center; flex: none; background: #0f2c6e; color: #fff; line-height: 1.1; }
  #tv .mc.next { border-color: #d4b659; background: #fffbea; }
  #tv .mc.next .tag { background: #d4b659; color: #0f2c6e; }
  #tv .mc.live { border-color: #16a34a; background: #f0fdf4; }
  #tv .mc.live .tag { background: #16a34a; }
  #tv .mc .who { flex: 1; min-width: 0; }
  /* Puna imena („Dominik Hvizdak / Josip Hovanjec") smiju u drugi red, ne režu se. */
  #tv .mc .who div { font-size: 24px; font-weight: 700; color: #0f2c6e; line-height: 1.15; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
