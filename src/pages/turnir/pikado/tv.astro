  #tv .rw { display: flex; align-items: center; gap: 12px; margin: 6px 12px 0; padding: 8px 12px; border-radius: 10px; border: 2px solid #dbe4f3; }
  #tv .rw .no { font-family: var(--font-display); font-size: 24px; width: 40px; height: 40px; border-radius: 50%; background: #0f2c6e; color: #fff; display: flex; align-items: center; justify-content: center; flex: none; }
  #tv .rw .who { flex: 1; min-width: 0; font-size: 20px; font-weight: 700; color: #0f2c6e; line-height: 1.2; }
