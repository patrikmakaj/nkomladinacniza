  /* Eliminacija */
  #tv .ko { grid-column: 1 / -1; grid-row: 1 / -1; }
  #tv .ko .cols { flex: 1; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 26px; padding: 20px; }
  #tv .ko .rnd { display: flex; flex-direction: column; justify-content: space-around; gap: 16px; }
  #tv .ko .rnd h3 { font-size: 22px; color: #64748b; letter-spacing: .12em; text-align: center; }
  #tv .km { border: 2px solid #dbe4f3; border-radius: 12px; overflow: hidden; }
  #tv .km.live { border-color: #16a34a; }
  #tv .km.next { border-color: #d4b659; }
  #tv .km .r { display: flex; align-items: center; gap: 10px; padding: 9px 14px; font-size: 23px; }
  #tv .km .r + .r { border-top: 1px solid #e2e8f0; }
  #tv .km .r span { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #tv .km .r b { font-family: var(--font-display); font-size: 28px; color: #1e40af; }
  #tv .km .r.w { background: #eff6ff; font-weight: 700; color: #0f2c6e; }
  #tv .km .r.tbd span { color: #94a3b8; font-style: italic; }
  #tv .km .lbl { font-family: var(--font-display); font-size: 15px; letter-spacing: .12em; text-transform: uppercase; padding: 4px 14px; background: #f1f5f9; color: #64748b; }

  /* Postolje */
  /* Kraj turnira: bez lijevog stupca, postolje preko cijele širine. */
  #tv.is-done .tv-main { grid-template-columns: 1fr; }
  #tv.is-done .col { display: none; }
  #tv.is-done .board { grid-template-columns: 1fr 1fr auto; grid-template-rows: 1fr auto; grid-auto-rows: auto; }
  #tv .podium { grid-column: 1 / -1; align-items: center; justify-content: flex-end; gap: 26px; padding-top: 30px; }
  #tv .podium .ttl2 { font-family: var(--font-display); font-size: 34px; color: #0f2c6e; letter-spacing: .03em; }
  #tv .podium .pl { display: flex; align-items: flex-end; gap: 28px; }
  #tv .podium .st { width: 420px; text-align: center; }
  #tv .podium .st .nm { font-size: 38px; font-weight: 800; color: #0f2c6e; margin-bottom: 12px; line-height: 1.15; }
  #tv .podium .st .bx { border-radius: 14px 14px 0 0; color: #fff; font-family: var(--font-display); padding-top: 18px; }
  #tv .podium .st .bx b { display: block; font-size: 88px; line-height: 1; }
  #tv .podium .st .bx span { font-size: 40px; }
  #tv .podium .g1 { background: linear-gradient(#e2c46a, #c9a443); }
  #tv .podium .g2 { background: linear-gradient(#b4bfcc, #8c99aa); }
  #tv .podium .g3 { background: linear-gradient(#c58d5c, #a26b3f); }
  #tv .h.soft { background: #dbeafe; color: #0f2c6e; }
  #tv .res { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-top: 1px solid #eef2f7; font-size: 24px; }
  #tv .res .lb { font-family: var(--font-display); font-size: 17px; letter-spacing: .12em; text-transform: uppercase; color: #64748b; width: 150px; flex: none; }
  #tv .res .sc { font-family: var(--font-display); font-size: 30px; color: #1e40af; }
  #tv .res .w { font-weight: 800; color: #0f2c6e; }
  #tv .rank { list-style: none; }
  #tv .rank li { display: flex; gap: 14px; padding: 9px 18px; font-size: 22px; border-top: 1px solid #eef2f7; }
  #tv .rank li b { font-family: var(--font-display); color: #0f2c6e; width: 40px; }
  #tv .board .qr { border-top: none; }

  /* Obavijest organizatora — opis turnira na Challongeu. */
  #tv .notice { display: flex; align-items: center; gap: 18px; padding: 12px 40px; background: #F6C500; color: #0f2c6e; font-size: 30px; font-weight: 700; }
  #tv .notice[hidden] { display: none; }
  #tv .notice span { font-size: 34px; }
  #tv .notice p { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Novi rezultat */
  #tv .toast { position: absolute; left: 50%; bottom: 70px; transform: translateX(-50%); background: #0f2c6e; color: #fff; border: 4px solid #d4b659; border-radius: 16px; padding: 18px 34px; font-size: 34px; box-shadow: 0 18px 50px rgba(15,44,110,.45); display: flex; align-items: center; gap: 18px; white-space: nowrap; animation: tvin .5s ease-out; }
  #tv .toast[hidden] { display: none; }
  #tv .toast .lb { font-family: var(--font-display); font-size: 22px; letter-spacing: .14em; text-transform: uppercase; color: #d4b659; }
  #tv .toast .sc { font-family: var(--font-display); font-size: 44px; color: #d4b659; }
  #tv .toast .w { font-weight: 800; }
  @keyframes tvin { from { opacity: 0; transform: translate(-50%, 30px); } }
  #tv tr.flash td { animation: tvflash 2s ease-in-out 4; }
  @keyframes tvflash { 50% { background: #fde68a; } }

  /* Odbrojavanje prije početka */
  #tv .pre { grid-column: 1 / -1; grid-row: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  #tv .cd { align-items: center; justify-content: center; text-align: center; gap: 10px; }
  #tv .cd .lb { font-family: var(--font-display); font-size: 30px; letter-spacing: .18em; text-transform: uppercase; color: #64748b; }
  #tv .cd .tm { font-family: var(--font-display); font-size: 150px; line-height: 1; color: #0f2c6e; font-variant-numeric: tabular-nums; }
  #tv .cd .at { font-size: 30px; color: #334155; }
  #tv .cd .n { font-family: var(--font-display); font-size: 64px; color: #d4b659; margin-top: 30px; }
  #tv .pre .list { columns: 2; column-gap: 0; padding: 8px 0; }
  #tv .pre .list div { break-inside: avoid; display: flex; gap: 10px; padding: 5px 14px; font-size: 18px; line-height: 1.25; border-bottom: 1px solid #eef2f7; }
  #tv .pre .list b { font-family: var(--font-display); color: #64748b; width: 34px; text-align: right; }

  #tv .tv-foot { padding: 9px 40px; background: #0f2c6e; color: rgba(255,255,255,.8); font-size: 17px; display: flex; justify-content: space-between; }
  #tv .tv-foot b { color: #d4b659; font-weight: 600; }
  #tv .tv-foot .err { color: #fca5a5; }

  #tv .setup { position: absolute; inset: 0; background: rgba(15,44,110,.96); color: #fff; display: flex; align-items: center; justify-content: center; text-align: center; }
  #tv .setup[hidden] { display: none; }
  #tv .setup div { max-width: 1100px; }
  #tv .setup h2 { font-size: 64px; margin-bottom: 24px; }
  #tv .setup p { font-size: 28px; line-height: 1.5; color: rgba(255,255,255,.85); }
  #tv .setup code { background: rgba(255,255,255,.15); padding: 2px 10px; border-radius: 6px; }
</style>

<script>
  import { pluralCroatian } from "../../../lib/croatian";

  type Cfg = { slug: string; fee: number; prizes: number[]; tvApi: string };
  type P = { id: string; name: string; seed: number; rank: number | null };
  type M = {
    id: string;
    state: string;
    round: number;
    order: number;
    live: boolean;
    consolation: boolean;
    created: number;
    groupAttr: string | null;
    a: string | null;
    b: string | null;
    sa: number | null;
    sb: number | null;
    winner: string | null;
  };

  const REFRESH_MS = 60_000;
  const TOKEN_KEY = "pikado_tv_token";
  const API = "https://api.challonge.com/v2.1";

  const esc = (s: unknown) =>
    String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  const $ = (id: string) => document.getElementById(id)!;
  const time = (d: Date) => d.toLocaleTimeString("hr-HR", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Zagreb" });
  const euro = (n: number) => {
    const digits = Number.isInteger(n) ? 0 : 2;
    return `${n.toLocaleString("hr-HR", { minimumFractionDigits: digits, maximumFractionDigits: digits })} €`;
  };

  /** Token iz adrese (#t=…) ili zapamćen u ovom pregledniku. */
  function readToken(): string | null {
    const h = new URLSearchParams(location.hash.slice(1));
    const t = h.get("t") || h.get("token");
    try {
      if (t) localStorage.setItem(TOKEN_KEY, t);
      return t || localStorage.getItem(TOKEN_KEY);
    } catch {
      return t;
    }
  }

  /** Challonge šalje dugu varijantu stanja; dovoljno nam je ovo. */
  function phase(state: string): string {
    if (state === "pending" || state === "checking_in" || state === "checked_in") return "Uskoro";
    if (state === "group_stages_underway") return "Uživo · Grupna faza";
    if (state === "awaiting_review" || state === "complete") return "Završeno";
    return "Uživo · Eliminacija";
  }

  function parse(json: any) {
    const t = json.data.attributes;
    const inc: any[] = json.included ?? [];
    const people: P[] = [];
    const byId = new Map<string, P>();
    for (const x of inc) {
      if (x.type !== "participant") continue;
      const a = x.attributes ?? {};
      if (a.states?.active === false) continue;
      const p: P = { id: String(x.id), name: String(a.name ?? "?"), seed: Number(a.seed) || 999, rank: a.final_rank ?? null };
      people.push(p);
      byId.set(p.id, p);
      // U grupnoj fazi Challonge zna mečeve vezati na „group player" id.
      for (const gid of a.group_player_ids ?? []) byId.set(String(gid), p);
    }
    const matches: M[] = [];
    for (const x of inc) {
      if (x.type !== "match") continue;
      const a = x.attributes ?? {};
      const pts: any[] = a.points_by_participant ?? [];
      const legs = (i: number) => {
        const s = pts[i]?.scores;
        return Array.isArray(s) && s.length ? s.reduce((n: number, v: number) => n + (Number(v) || 0), 0) : null;
      };
      const pid = (i: number) => (pts[i]?.participant_id != null ? byId.get(String(pts[i].participant_id))?.id ?? null : null);
      matches.push({
        id: String(x.id),
        state: a.state,
        round: Number(a.round) || 0,
        order: Number(a.suggested_play_order) || 1e6,
        live: a.state === "open" && !!a.timestamps?.underway_at,
        consolation: !!a.consolation || /3P/i.test(String(a.identifier ?? "")),
        created: Date.parse(a.timestamps?.created_at ?? "") || 0,
        groupAttr: a.group_id != null ? String(a.group_id) : null,
        a: pid(0),
        b: pid(1),
        sa: legs(0),
        sb: legs(1),
        winner: a.winner_id != null ? byId.get(String(a.winner_id))?.id ?? null : null,
      });
    }
    return { t, people, byId, matches };
  }

  /** Mečevi grupne faze i grupe (povezane cjeline svatko-sa-svakim). */
  function splitStages(matches: M[], people: P[]) {
    if (!matches.length) return { groups: [] as { name: string; ids: string[]; ms: M[] }[], ko: [] as M[] };
    let gm: M[];
    if (matches.some((m) => m.groupAttr)) {
      gm = matches.filter((m) => m.groupAttr);
    } else {
      // Grupni mečevi nastanu odjednom na startu; eliminacija tek kad se grupe zaključe.
      const first = Math.min(...matches.map((m) => m.created));
      gm = matches.filter((m) => m.created - first < 120_000);
    }
    const ko = matches.filter((m) => !gm.includes(m));
    // Union-find po sudionicima.
    const parent = new Map<string, string>();
    const find = (x: string): string => (parent.get(x) === x ? x : (parent.set(x, find(parent.get(x)!)), parent.get(x)!));
    for (const m of gm) for (const id of [m.a, m.b]) if (id && !parent.has(id)) parent.set(id, id);
    for (const m of gm) if (m.a && m.b) parent.set(find(m.a), find(m.b));
    const sets = new Map<string, string[]>();
    for (const id of parent.keys()) {
      const r = find(id);
      sets.set(r, [...(sets.get(r) ?? []), id]);
    }
    const seed = (id: string) => people.find((p) => p.id === id)?.seed ?? 999;
    const groups = [...sets.values()]
      .sort((x, y) => Math.min(...x.map(seed)) - Math.min(...y.map(seed)))
      .map((ids, i) => ({
        name: String.fromCharCode(65 + i),
        ids,
        ms: gm.filter((m) => (m.a && ids.includes(m.a)) || (m.b && ids.includes(m.b))),
      }));
    // Grupna faza bez ijednog meča s poznatim igračima → nema grupa.
    return { groups: groups.filter((g) => g.ids.length > 1), ko };
  }

  function standings(ids: string[], ms: M[]) {
    const row = new Map(ids.map((id) => [id, { id, w: 0, l: 0, lf: 0, la: 0 }]));
    for (const m of ms) {
      if (m.state !== "complete" || !m.a || !m.b) continue;
      const A = row.get(m.a)!, B = row.get(m.b)!;
      A.lf += m.sa ?? 0; A.la += m.sb ?? 0; B.lf += m.sb ?? 0; B.la += m.sa ?? 0;
      if (m.winner === m.a) { A.w++; B.l++; } else if (m.winner === m.b) { B.w++; A.l++; }
    }
    const h2h = (x: string, y: string) => {
      const m = ms.find((m) => m.state === "complete" && ((m.a === x && m.b === y) || (m.a === y && m.b === x)));
      return m?.winner === x ? -1 : m?.winner === y ? 1 : 0;
    };
    return [...row.values()].sort((x, y) => y.w - x.w || h2h(x.id, y.id) || (y.lf - y.la) - (x.lf - x.la) || y.lf - x.lf);
  }

  /** Opis turnira s Challongea kao obican tekst (zna doci kao HTML). */
  function plain(html: unknown): string {
    const doc = new DOMParser().parseFromString(String(html ?? ""), "text/html");
    return (doc.body.textContent ?? "").replace(/\s+/g, " ").trim();
  }

  // Stanje izmedu osvjezavanja: koji su mecevi vec bili zavrseni i kad pocinje turnir.
  let seenDone: Set<string> | null = null;
  let startsAt: number | null = null;
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  function countdown() {
    const el = document.getElementById("tv-cd");
    if (!el || startsAt == null) return;
    const s = Math.max(0, Math.round((startsAt - Date.now()) / 1000));
    const pad = (n: number) => String(n).padStart(2, "0");
    el.textContent = s > 0 ? `${pad(Math.floor(s / 3600))}:${pad(Math.floor((s % 3600) / 60))}:${pad(s % 60)}` : "Uskoro!";
  }

  function render(json: any, cfg: Cfg) {
    const { t, people, byId, matches } = parse(json);

    // 1) Obavijest organizatora iz opisa turnira.
    const notice = plain(t.description);
    $("tv-notice").hidden = !notice;
    $("tv-notice-text").textContent = notice;
    const name = (id: string | null) => (id ? byId.get(id)?.name ?? "?" : null);
    const fund = people.length * cfg.fee;
    $("tv-phase").textContent = phase(t.state);
    $("tv-fund").textContent = fund ? euro(fund) : "—";

    const { groups, ko } = splitStages(matches, people);
    // Koliko ih prolazi iz grupe — postavka turnira na Challongeu (zadano 2).
    const adv = Math.max(1, Number(t.group_stage_options?.participant_count_to_advance_per_group) || 2);
    const groupOf = (m: M) => groups.find((g) => g.ms.includes(m))?.name;
    const koLabel = (m: M) => {
      if (m.consolation) return "Za 3. mjesto";
      const n = ko.filter((x) => x.round === m.round && !x.consolation).length;
      return n === 1 ? "Finale" : n === 2 ? "Polufinale" : n === 4 ? "Četvrtfinale" : `${m.round}. kolo`;
    };
    const stageTag = (m: M) => (groupOf(m) ? `Grupa ${groupOf(m)}` : koLabel(m));

    // ── Igra se · na redu ─────────────────────────────────────────────
    const open = matches.filter((m) => m.state === "open" && m.a && m.b);
    const live = open.filter((m) => m.live).sort((x, y) => x.order - y.order).slice(0, 2);
    const next = open.filter((m) => !m.live).sort((x, y) => x.order - y.order || x.round - y.round);
    // Do 2 meča koja se igraju (2 pikada) i 4 sljedeća po Challongeovom redoslijedu.
    const row = (m: M, cls: string, no: string) =>
      `<div class="rw ${cls}"><div class="no">${no}</div><div class="who"><div>${esc(name(m.a))}</div><span>VS</span><div>${esc(name(m.b))}</div></div><span class="gtag">${esc(groupOf(m) ?? koLabel(m))}</span></div>`;
    const upcoming = next.slice(0, 4);
    $("tv-queue").innerHTML = live.length || upcoming.length
      ? (live.length ? `<div class="sec lv"><i class="dt"></i>Igra se</div>${live.map((m) => row(m, "live", "UŽIVO")).join("")}` : "") +
        (upcoming.length ? `<div class="sec">Na redu<small style="margin-left:auto;font-family:var(--font-sans);font-size:14px;letter-spacing:0;text-transform:none;color:#64748b">prvi slobodni pikado</small></div>${upcoming.map((m, i) => row(m, i === 0 ? "first" : "", String(i + 1))).join("")}` : "")
      : `<p class="empty">${t.state === "complete" || t.state === "awaiting_review" ? "Turnir je završen. Čestitamo pobjednicima!" : t.state === "pending" ? "Mečevi se pojavljuju nakon ždrijeba." : "Čekamo sljedeće mečeve…"}</p>`;

    // ── Glavni dio ────────────────────────────────────────────────────
    const board = $("tv-board");
    const done = t.state === "complete" || t.state === "awaiting_review";
    const ranked = people.filter((p) => p.rank != null && p.rank <= 3).sort((a, b) => a.rank! - b.rank!);

    const showPodium = done && ranked.length > 0;
    $("tv").classList.toggle("is-done", showPodium);
    if (showPodium) {
      const heights: Record<number, number> = { 1: 280, 2: 210, 3: 160 };
      const podium = [2, 1, 3]
        .map((r) => {
          const p = ranked.find((x) => x.rank === r);
          if (!p) return "";
          const prize = fund ? euro(fund * (cfg.prizes[r - 1] ?? 0)) : "";
          return `<div class="st"><div class="nm">${r === 1 ? "🏆 " : ""}${esc(p.name)}</div><div class="bx g${r}" style="height:${heights[r]}px"><b>${r}.</b><span>${prize}</span></div></div>`;
        })
        .join("");
      // Finale = zadnje kolo bez meča za 3. mjesto.
      const lastRound = Math.max(0, ...ko.filter((m) => !m.consolation).map((m) => m.round));
      const finals = [
        ...ko.filter((m) => !m.consolation && m.round === lastRound).map((m) => ({ m, lb: "Finale" })),
        ...ko.filter((m) => m.consolation).map((m) => ({ m, lb: "Za 3. mjesto" })),
      ].filter(({ m }) => m.state === "complete" && m.a && m.b);
      const resHtml = finals
        .map(({ m, lb }) => {
          const [w, l, sw, sl] = m.winner === m.b ? [m.b, m.a, m.sb, m.sa] : [m.a, m.b, m.sa, m.sb];
          return `<div class="res"><span class="lb">${lb}</span><span class="w">${esc(name(w))}</span><span class="sc">${sw ?? ""}:${sl ?? ""}</span><span>${esc(name(l))}</span></div>`;
        })
        .join("");
      const rest = people.filter((p) => p.rank != null && p.rank > 3 && p.rank <= 8).sort((a, b) => a.rank! - b.rank! || a.seed - b.seed);
      const qr = document.querySelector("#tv .col .qr")?.outerHTML ?? "";
      board.innerHTML = `<div class="card podium"><div class="ttl2">Pobjednici 2. pikado turnira · hvala svima!</div><div class="pl">${podium}</div></div>
        <div class="card"><div class="h soft">Finale i za 3. mjesto</div>${resHtml || '<p class="empty">—</p>'}</div>
        <div class="card"><div class="h soft">${rest.length ? `Ostali plasmani (${rest[0].rank}.–${rest[rest.length - 1].rank}.)` : "Ostali plasmani"}</div><ul class="rank">${rest
          .map((p) => `<li><b>${p.rank}.</b><span>${esc(p.name)}</span></li>`)
          .join("")}</ul></div>
        <div class="card">${qr}</div>`;
    } else if (ko.length) {
      const rounds = [...new Set(ko.filter((m) => !m.consolation).map((m) => m.round))].sort((a, b) => a - b);
      const kmHtml = (m: M) => {
        const r = (id: string | null, s: number | null) =>
          `<div class="r ${id && m.winner === id ? "w" : ""} ${id ? "" : "tbd"}"><span>${id ? esc(name(id)) : "čeka se"}</span><b>${m.state === "complete" && s != null ? s : ""}</b></div>`;
        const cls = m.live ? "live" : next[0] === m ? "next" : "";
        return `<div class="km ${cls}">${m.live ? '<div class="lbl">● Igra se</div>' : ""}${r(m.a, m.sa)}${r(m.b, m.sb)}</div>`;
      };
      const cols = rounds.map((rd) => {
        const ms = ko.filter((m) => m.round === rd && !m.consolation).sort((a, b) => a.order - b.order || Number(a.id) - Number(b.id));
        const third = rd === Math.max(...rounds) ? ko.filter((m) => m.consolation) : [];
        return `<div class="rnd"><h3>${esc(koLabel(ms[0]))}</h3>${ms.map(kmHtml).join("")}${third
          .map((m) => `<h3>Za 3. mjesto</h3>${kmHtml(m)}`)
          .join("")}</div>`;
      });
      board.innerHTML = `<div class="card ko"><div class="h">Eliminacija<small>${esc(phase(t.state))}</small></div><div class="cols">${cols.join("")}</div></div>`;
    } else if (groups.length) {
      board.innerHTML = groups
        .map((g) => {
          const rows = standings(g.ids, g.ms);
          const played = g.ms.filter((m) => m.state === "complete").length;
          return `<div class="card"><div class="h">Grupa ${g.name}<small>odigrano ${played} / ${g.ms.length}</small></div>
            <table><thead><tr><th></th><th class="p">Par</th><th>P</th><th>I</th><th>Legovi</th></tr></thead><tbody>${rows
              .map(
                (r, i) =>
                  `<tr data-id="${esc(r.id)}" class="${i < adv ? "q" : ""} ${i === adv - 1 ? "cut" : ""}"><td class="n">${i + 1}</td><td class="p">${esc(name(r.id))}</td><td>${r.w}</td><td>${r.l}</td><td>${r.lf}:${r.la}</td></tr>`,
              )
              .join("")}</tbody></table></div>`;
        })
        .join("");
    } else {
      // 2) Prije starta: odbrojavanje i popis prijavljenih.
      startsAt = Date.parse(t.timestamps?.starts_at ?? t.starts_at ?? "") || null;
      const at = startsAt
        ? new Date(startsAt).toLocaleString("hr-HR", { weekday: "long", hour: "2-digit", minute: "2-digit", timeZone: "Europe/Zagreb" })
        : "";
      board.innerHTML = `<div class="pre">
        <div class="card cd"><div class="lb">Turnir počinje za</div><div class="tm" id="tv-cd">--:--:--</div><div class="at">${esc(at)}</div>
          <div class="n">${people.length} ${pluralCroatian(people.length, "par", "para", "parova")}</div><div class="at">prijavljeno</div></div>
        <div class="card"><div class="h">Prijavljeni parovi<small>${people.length}</small></div><div class="list">${people
          .sort((a, b) => a.seed - b.seed)
          .map((p, i) => `<div><b>${i + 1}.</b><span>${esc(p.name)}</span></div>`)
          .join("")}</div></div></div>`;
      countdown();
    }

    // 3) Novi rezultat: traka na 20 s i bljesak redova u grupi.
    const doneNow = matches.filter((m) => m.state === "complete" && m.a && m.b);
    if (seenDone) {
      const fresh = doneNow.filter((m) => !seenDone!.has(m.id));
      if (fresh.length) {
        const m = fresh[fresh.length - 1];
        const [w, l, sw, sl] = m.winner === m.b ? [m.b, m.a, m.sb, m.sa] : [m.a, m.b, m.sa, m.sb];
        const toast = $("tv-toast");
        toast.innerHTML = `<span class="lb">Novi rezultat · ${esc(stageTag(m))}</span><span class="w">${esc(name(w))}</span><span class="sc">${sw ?? ""}:${sl ?? ""}</span><span>${esc(name(l))}</span>`;
        toast.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => (toast.hidden = true), 20_000);
        const ids = new Set(fresh.flatMap((x) => [x.a, x.b]));
        document.querySelectorAll<HTMLElement>("#tv-board tr[data-id]").forEach((tr) => {
          if (ids.has(tr.dataset.id ?? "")) tr.classList.add("flash");
        });
      }
    }
    seenDone = new Set(doneNow.map((m) => m.id));

    const gTotal = groups.reduce((n, g) => n + g.ms.length, 0);
    const toKo = groups.length * adv;
    const koName = toKo === 8 ? "četvrtfinale" : toKo === 4 ? "polufinale" : toKo === 2 ? "finale" : "eliminaciju";
    const advText = `${adv === 1 ? "Prvi" : `${pluralCroatian(adv, "Prvi", "Prva", "Prvih")} ${adv}`} iz svake grupe ${adv === 1 ? "ide" : "idu"} u ${koName}`;
    const gDone = groups.reduce((n, g) => n + g.ms.filter((m) => m.state === "complete").length, 0);
    $("tv-note").innerHTML = done
      ? `Turnir je završen — čestitamo pobjednicima! · <b>${esc(location.host)}/turnir/pikado</b>`
      : ko.length
      ? `Eliminacija · rezultati i na <b>${esc(location.host)}/turnir/pikado</b>`
      : `${advText}${gTotal ? ` · odigrano <b>${gDone} / ${gTotal}</b> mečeva u grupama` : ""}`;
  }

  let timer: ReturnType<typeof setInterval> | undefined;
  let clock: ReturnType<typeof setInterval> | undefined;

  function setup() {
    const cfgEl = document.getElementById("tv-config");
    const tv = document.getElementById("tv");
    if (!cfgEl || !tv) return;
    const cfg: Cfg = JSON.parse(cfgEl.textContent || "{}");
    const slug = new URLSearchParams(location.hash.slice(1)).get("s") || cfg.slug;

    // 1920×1080 skalirano na ekran, centrirano.
    const fit = () => {
      const k = Math.min(innerWidth / 1920, innerHeight / 1080);
      tv.style.transform = `scale(${k})`;
      tv.style.left = `${(innerWidth - 1920 * k) / 2}px`;
      tv.style.top = `${(innerHeight - 1080 * k) / 2}px`;
    };
    fit();
    addEventListener("resize", fit);

    const tick = () => {
      const now = new Date();
      $("tv-clock").textContent = time(now);
      $("tv-date").textContent = now.toLocaleDateString("hr-HR", { weekday: "long", day: "numeric", month: "numeric", timeZone: "Europe/Zagreb" });
    };
    tick();
    clock = setInterval(() => {
      tick();
      countdown();
    }, 1000);

    const token = cfg.tvApi ? null : readToken();
    const setupBox = $("tv-setup");
    if (!cfg.tvApi && !token) {
      setupBox.hidden = false;
      return;
    }
    let last: Date | null = null;
    const load = async () => {
      try {
        // S posrednikom: bez tokena, turnir zna Worker. Bez njega: izravno s
        // tokenom iz adrese — radi samo u pregledniku pokrenutom bez CORS provjere.
        const res = cfg.tvApi
          ? await fetch(cfg.tvApi, { cache: "no-store" })
          : await fetch(`${API}/tournaments/${encodeURIComponent(slug)}.json?include=participants,matches`, {
              headers: {
                "Authorization-Type": "v2",
                Authorization: `Bearer ${token}`,
                "Content-Type": "application/vnd.api+json",
                Accept: "application/json",
              },
              cache: "no-store",
            });
        if (res.status === 401 || res.status === 403) {
          setupBox.hidden = false;
          $("tv-setup-detail").textContent = "Ključ je istekao ili nije ispravan — zatraži novi link.";
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        render(await res.json(), cfg);
        setupBox.hidden = true;
        last = new Date();
        $("tv-status").textContent = `Osvježeno ${time(last)}`;
      } catch (err) {
        $("tv-status").innerHTML = `<span class="err">Nema veze s Challongeom — pokušavam ponovo${last ? ` · zadnje ${time(last)}` : ""}</span>`;
      }
    };
    load();
    timer = setInterval(load, REFRESH_MS);
  }

  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", () => {
    clearInterval(timer);
    clearInterval(clock);
  });
</script>
