---
/**
 * Turnir u pucanju jedanaesteraca — DŠA Niza, petak 28.08.2026. u 19:00.
 *
 * Logika je zajednička s boćanjem (components/TurnirLive.astro + lib/turnir.ts);
 * ovdje su samo konfiguracija Sheeta i pravila ovog turnira.
 *
 * Sheet mora imati tabove `Ekipe` i `Utakmice` i biti dijeljen kao
 * „Bilo tko s poveznicom → Preglednik". Ždrijeb i raspored se generiraju
 * Apps Scriptom u samom Sheetu (scripts/apps-script/zdrijeb.gs).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import TurnirLive from "../../components/TurnirLive.astro";
import type { TurnirConfig } from "../../lib/turnir";

const config: TurnirConfig = {
  // „Turnir u pucanju jedanaesteraca — DŠA Niza 28.08.2026." u klupskom Driveu.
  sheetId: "1Gi3OUo0QViOwJyK1DR_ccijA_aKcBoHqfXJf__J9IpE",
  tabs: { teams: "Ekipe", matches: "Utakmice" },
  // Ekipe: Grupa | Ekipa | Igrač 1..4 | Vratar | Kotizacija
  teamCols: { group: 0, name: 1, players: [2, 3, 4, 5, 6] },
  // Utakmice: Redni | Faza | Grupa | Vrijeme | Teren | Domaćin | Gost | Golovi D | Golovi G
  matchCols: {
    redni: 0,
    faza: 1,
    grupa: 2,
    vrijeme: 3,
    teren: 4,
    home: 5,
    away: 6,
    scoreHome: 7,
    scoreAway: 8,
  },
  // Dva gola paralelno.
  courts: 2,
  unit: {
    label: "Golovi",
    totalLabel: "Ukupno golova",
    mostLabel: "Najviše zabijenih golova",
    countWord: "golova",
  },
  teamWord: "Ekipa",
  playersLabel: "Igrači (4 + vratar)",
  start: "2026-08-28T19:00:00",
  followKey: "penali_follow",
  qualifiersPerGroup: 2,
};
---

{/* Jednokratni događaj — nije u navigaciji i ne treba biti u tražilicama.
    Kad turnir prođe, ostaje kao arhiva na direktan link. */}
<BaseLayout
  title="Turnir u pucanju jedanaesteraca"
  description="Rezultati uživo — Turnir u pucanju jedanaesteraca, DŠA Niza, igralište u Nizi. Grupne tablice, raspored i eliminacija u stvarnom vremenu."
  noIndex
>
  <TurnirLive
    title="Turnir u pucanju jedanaesteraca"
    subtitle="DŠA Niza · Petak 28.08. u 19:00 · Igralište u Nizi"
    config={config}
    registrationNote="Prijave do 18:30 na dan turnira. Ždrijeb grupa odmah nakon zatvaranja prijava. Klikni ekipu za sastav."
    groupsNote="Nema neriješenih — kod izjednačenja ide raspucavanje. Kod jednakog broja pobjeda: međusobni susret → razlika golova → zabijeni golovi."
  >
    <Fragment slot="prazno">
      <div class="bg-white rounded-lg shadow-md border border-[#C9D4E8] overflow-hidden">
        <div class="px-5 py-3 text-white font-display uppercase tracking-wider text-sm" style="background:#10275c">
          Prijave su otvorene
        </div>
        <div class="p-5 md:p-6">
          <p class="text-[#334155] mb-5">
            Popis ekipa pojavljuje se ovdje čim stignu prve prijave, a ždrijeb i raspored
            odmah nakon što se prijave zatvore.
          </p>

          <div class="grid gap-3 sm:grid-cols-3 mb-5">
            <div class="bg-[#EAF0FB] rounded-lg p-4 text-center">
              <div class="text-[11px] font-display uppercase tracking-wider text-[#64748B]">Ekipa</div>
              <div class="font-display font-bold text-2xl text-[#10275c]">4 + 1</div>
              <div class="text-xs text-[#64748B] mt-0.5">izvođači i vratar</div>
            </div>
            <div class="bg-[#EAF0FB] rounded-lg p-4 text-center">
              <div class="text-[11px] font-display uppercase tracking-wider text-[#64748B]">Kotizacija</div>
              <div class="font-display font-bold text-2xl text-[#10275c]">20 €</div>
              <div class="text-xs text-[#64748B] mt-0.5">po ekipi</div>
            </div>
            <div class="bg-[#EAF0FB] rounded-lg p-4 text-center">
              <div class="text-[11px] font-display uppercase tracking-wider text-[#64748B]">Prijave do</div>
              <div class="font-display font-bold text-2xl text-[#10275c]">18:30</div>
              <div class="text-xs text-[#64748B] mt-0.5">na dan turnira</div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="tel:+385912680220"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-display uppercase tracking-wider text-sm font-bold bg-[#F6C500] text-[#10275c] hover:brightness-110 transition"
            >
              📞 091 268 0220 — Patrik
            </a>
            <span class="text-sm text-[#64748B]">ili se javi na igralištu</span>
          </div>

          <div class="mt-5 pt-4 border-t border-[#C9D4E8] grid gap-2 sm:grid-cols-3 text-sm text-[#334155]">
            <div><strong class="text-[#10275c]">1. mjesto</strong> · 50 % kotizacije</div>
            <div><strong class="text-[#10275c]">2. mjesto</strong> · 30 % kotizacije</div>
            <div><strong class="text-[#10275c]">3. mjesto</strong> · 20 % kotizacije</div>
          </div>
        </div>
      </div>
    </Fragment>

    <Fragment slot="pravila">
      <p class="text-[#64748B] mb-4">
        Turnir u pucanju jedanaesteraca · DŠA Niza · igralište u Nizi
      </p>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">1. Prijave i kotizacija</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li>Ekipa broji <strong>4 izvođača + 1 vratar</strong>.</li>
        <li>Kotizacija <strong>20 € po ekipi</strong>, plaća se pri prijavi.</li>
        <li>Prijave <strong>do 18:30</strong> na dan turnira, na igralištu ili porukom na <strong>091 268 0220</strong> (Patrik).</li>
        <li>Ždrijeb grupa je odmah nakon zatvaranja prijava; raspored se objavljuje na ovoj stranici.</li>
      </ul>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">2. Format natjecanja</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li>Format ovisi o broju prijavljenih ekipa — ždrijeb je odmah nakon zatvaranja prijava.</li>
        <li>
          <strong>Do 6 ekipa:</strong> jedna skupina, <strong>svi igraju sa svima</strong>.
          Prve dvije iz tablice idu u <strong>finale</strong>, treća i četvrta na
          <strong>meč za 3. mjesto</strong>.
        </li>
        <li>
          <strong>7 i više ekipa:</strong> ždrijeb u grupe (dvije, a od 12 ekipa četiri),
          u grupi <strong>svako sa svakim</strong>, pa <strong>prve dvije iz svake grupe</strong>
          u eliminaciju do finala i meča za 3. mjesto.
        </li>
        <li>Puca se na <strong>dva gola paralelno</strong> — dva meča idu istovremeno.</li>
        <li>Parovi eliminacije slažu se <strong>unakrsno</strong> — nitko ne igra protiv ekipe iz svoje grupe.</li>
      </ul>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">3. Tijek meča</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li>Svaka ekipa izvodi <strong>seriju od 5 jedanaesteraca</strong>.</li>
        <li>Ekipe pucaju <strong>naizmjenično</strong>; brani vratar protivničke ekipe.</li>
        <li>Pobjednik je ekipa s <strong>više zabijenih golova</strong> iz serije.</li>
      </ul>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">4. Raspucavanje</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li><strong>Nema neriješenih rezultata</strong> — ni u grupi ni u eliminaciji.</li>
        <li>
          Ako je nakon serije od 5 izjednačeno, ide <strong>raspucavanje do prve odluke</strong>:
          po jedan udarac svake ekipe dok jedna zabije, a druga promaši.
        </li>
        <li>U raspucavanju redoslijed izvođača kreće ispočetka.</li>
        <li>U rezultat se upisuje <strong>konačan ishod, uključujući raspucavanje</strong>.</li>
      </ul>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">5. Izvođenje udarca</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li>Puca se s <strong>bijele točke</strong>, lopta mora mirovati.</li>
        <li>Vratar mora biti <strong>na crti gola</strong> do trenutka udarca; smije se kretati bočno.</li>
        <li>Izvođač smije uzeti zalet, ali <strong>ne smije prekidati zalet</strong> nakon što krene.</li>
        <li>Udarac je gotov čim lopta prestane biti u igri — <strong>nema naknadnog udarca</strong> na odbijenu loptu.</li>
        <li>Lopta koja se od vratara ili stative odbije u gol — <strong>vrijedi</strong>.</li>
      </ul>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">6. Poredak u skupini</h3>
      <p>
        Kako nema neriješenih, poredak ide po <strong>broju pobjeda</strong>. Kod jednakog broja
        pobjeda odlučuje: <strong>1) međusobni susret</strong>, <strong>2) razlika golova</strong>
        (zabijeni − primljeni), <strong>3) ukupno zabijeni golovi</strong>.
      </p>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">7. Nagrade</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li>1. mjesto — <strong>50 %</strong> ukupne kotizacije</li>
        <li>2. mjesto — <strong>30 %</strong> ukupne kotizacije</li>
        <li>3. mjesto — <strong>20 %</strong> ukupne kotizacije</li>
      </ul>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">8. Raspored i satnica</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li>Raspored i rezultati uživo: <strong>omladinacniza.hr/turnir/penali</strong>.</li>
        <li>Vremena su <strong>okvirna</strong> i mogu se pomicati ovisno o tijeku turnira; uz svaki meč piše <strong>na kojem se golu</strong> puca.</li>
        <li>Ekipa koja se ne pojavi u roku <strong>5 min</strong> od poziva gubi meč bez borbe.</li>
      </ul>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">9. Ponašanje i fair play</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li>Očekuje se <strong>sportsko ponašanje</strong> prema protivnicima i organizatorima.</li>
        <li>Grubo nesportsko ponašanje = <strong>opomena ili diskvalifikacija</strong> ekipe.</li>
      </ul>

      <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">10. Završne odredbe</h3>
      <ul class="list-disc pl-5 space-y-1">
        <li><strong>Organizator (DŠA Niza)</strong> zadržava pravo izmjene rasporeda i pravila prije početka turnira.</li>
        <li>Sudjelovanjem ekipe prihvaćaju ova pravila.</li>
      </ul>
    </Fragment>
  </TurnirLive>
</BaseLayout>
