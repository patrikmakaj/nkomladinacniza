---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Logo from "../components/Logo.astro";
import LeagueTable from "../components/LeagueTable.astro";
import StatRanking from "../components/StatRanking.astro";
import { url } from "../lib/url";
import { golLabel, nastupLabel } from "../lib/croatian";
import {
  competitionsFor,
  hasStats,
  todayInZagreb,
  OUR_CLUB_ID,
  type UnifiedMatch,
  type CompetitionStats,
} from "../lib/matches";

// Natjecanja početnika (U-11) s HNS Semafora. Prazno dok HNS ne objavi
// raspored — cijela sekcija se tada jednostavno ne renderira.
const youthCompetitions = competitionsFor("Beginners");

/** Predstojeće utakmice (neodigrane čiji datum nije prošao), najbliža prva. */
function upcomingOf(matches: UnifiedMatch[]): UnifiedMatch[] {
  return matches.filter((m) => !m.played && m.date >= todayInZagreb);
}

/** Odigrane utakmice, najnovija prva. */
function playedOf(matches: UnifiedMatch[]): UnifiedMatch[] {
  return matches
    .filter((m) => m.played)
    .sort((a, b) => b.iso.localeCompare(a.iso));
}

function formatMatchDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("hr-HR", {
    weekday: "short",
    day: "numeric",
    month: "short",
  });
}

const outcomeColor = { W: "bg-green-600", D: "bg-yellow-500", L: "bg-red-600" };
const outcomeLetter = { W: "P", D: "N", L: "I" };
const outcomeTitle = { W: "Pobjeda", D: "Neriješeno", L: "Poraz" };

// ── Ranking liste ─────────────────────────────────────────────────────
// Iste komponente kao na /momcad. Igrači mlađih kategorija nemaju profil na
// našoj stranici (/igrac/[id] se gradi samo iz seniorskog rostera), pa se
// linka ravno na HNS Semafor.

const cardSvg = (color: string) =>
  `<svg width="10" height="14" viewBox="0 0 10 14" fill="${color}" xmlns="http://www.w3.org/2000/svg" class="inline-block"><rect width="10" height="14" rx="1"/></svg>`;

function rankingItems(stats: CompetitionStats) {
  return {
    scorers: stats.topScorers.slice(0, 10).map((p) => ({
      position: p.position,
      name: p.name,
      photo: p.photo,
      profileUrl: p.profileUrl,
      valueHtml:
        `<span>${p.goals ?? 0}</span>` +
        `<span class="text-club-muted text-xs font-normal">${golLabel(p.goals ?? 0)}</span>`,
    })),
    cards: stats.topCards.slice(0, 10).map((p) => {
      const parts: string[] = [];
      if ((p.yellow ?? 0) > 0) parts.push(`${cardSvg("#eab308")} <span>${p.yellow}</span>`);
      if ((p.red ?? 0) > 0) parts.push(`${cardSvg("#dc2626")} <span>${p.red}</span>`);
      return {
        position: p.position,
        name: p.name,
        photo: p.photo,
        profileUrl: p.profileUrl,
        valueHtml: parts.length
          ? parts.join(' <span class="w-1"></span> ')
          : '<span class="text-club-muted">—</span>',
      };
    }),
    apps: stats.topApps.slice(0, 10).map((p) => ({
      position: p.position,
      name: p.name,
      photo: p.photo,
      profileUrl: p.profileUrl,
      valueHtml:
        `<span>${p.appearances ?? 0}</span>` +
        `<span class="text-club-muted text-xs font-normal">${nastupLabel(p.appearances ?? 0)}</span>`,
    })),
  };
}

const categories = [
  {
    age: "U9",
    name: "Do 9 godina",
    description:
      "Najmlađa selekcija — kroz igru, zabavu i osnovne vježbe motorike djeca uče prve korake u nogometu i razvijaju ljubav prema sportu.",
  },
  {
    age: "U11",
    name: "Do 11 godina",
    description:
      "Selekcija u kojoj se učvršćuju osnovne tehničke vještine, razvija timski duh i priprema za organizirani nastup u natjecanjima.",
  },
];
---

<BaseLayout
  title="Mlađe kategorije"
  description="Mlađe kategorije NK Omladinac Niza — raspored i ljestvica početnika U11, prijave za U9 i U11. Kroz povijest kluba afirmiralo se više od 100 djece iz Nize i okolice."
>
  <Hero
    title="Mlađe kategorije"
    subtitle="Prijave za U9 i U11 otvorene su putem Facebooka"
    height="md"
  />

  <section class="container-narrow mt-12">
    <!-- Uvodni info blok -->
    <div class="bg-white border border-club-border rounded-lg p-6 md:p-8 mb-10">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-full bg-club-light flex items-center justify-center flex-shrink-0 text-2xl">
          ⚽
        </div>
        <div>
          <h2 class="text-2xl mb-2">Mladi igrači NK Omladinac Niza</h2>
          <p class="text-club-secondary/80 leading-relaxed">
            Kroz povijest kluba treniralo se i afirmiralo u lokalne i regionalne klubove
            <strong>više od 100 djece</strong> iz Nize i okolice — što svjedoči
            dugogodišnjoj predanosti radu s mladim naraštajima u malom selu od oko
            400 stanovnika. Klub nastavlja tu tradiciju i prima prijave za
            kategorije <strong>U9 i U11</strong>.
          </p>
        </div>
      </div>
    </div>

    <!-- Selekcije -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      {
        categories.map((c) => (
          <article class="bg-white border border-club-border rounded-lg overflow-hidden hover:shadow-lg transition-shadow flex flex-col">
            <div class="bg-gradient-to-r from-club-primary-deep to-club-primary text-white px-6 py-4 flex items-center gap-3">
              <div class="bg-club-accent text-club-primary-deep px-3 py-1 rounded font-display font-bold text-lg">
                {c.age}
              </div>
              <h3 class="text-xl">{c.name}</h3>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <p class="text-club-secondary/80 leading-relaxed mb-4 flex-1">
                {c.description}
              </p>
              <div class="pt-4 border-t border-club-border">
                <span class="inline-flex items-center gap-1.5 text-sm font-medium text-club-primary">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                  Prijave putem Facebooka
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Natjecanje U-11: raspored i ljestvica s HNS Semafora -->
    {youthCompetitions.map((comp) => {
      const upcoming = upcomingOf(comp.matches);
      const results = playedOf(comp.matches);
      if (upcoming.length === 0 && results.length === 0 && comp.table.length === 0) {
        return null;
      }
      return (
        <div class="mb-10">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
            <h2 class="text-2xl">U11 u natjecanju</h2>
            {comp.url && (
              <a
                href={comp.url}
                target="_blank"
                rel="noopener"
                class="text-xs font-display uppercase tracking-wider text-club-primary hover:underline"
              >
                HNS Semafor →
              </a>
            )}
          </div>
          <p class="text-sm text-club-muted mb-6">{comp.name}</p>

          <div class="grid lg:grid-cols-2 gap-6 items-start">
            {/* Utakmice */}
            <div class="space-y-6">
              {upcoming.length > 0 && (
                <div>
                  <h3 class="text-lg mb-3">Sljedeće utakmice</h3>
                  <ul class="space-y-2">
                    {upcoming.slice(0, 5).map((m) => {
                      const opponent = m.isHome ? m.away : m.home;
                      return (
                        <li class="bg-white border border-club-border rounded-lg px-3 py-3 flex items-center gap-3">
                          <div class="w-20 flex-shrink-0 text-xs">
                            <p class="font-display font-bold text-club-primary-deep">
                              {formatMatchDate(m.iso)}
                            </p>
                            <p class="text-club-muted">{m.time ?? "—"}</p>
                          </div>
                          <div class="w-7 h-7 flex-shrink-0 flex items-center justify-center">
                            {opponent.id === OUR_CLUB_ID ? (
                              <Logo size={28} />
                            ) : opponent.logo ? (
                              <img
                                src={opponent.logo}
                                alt=""
                                width="28"
                                height="28"
                                class="object-contain w-full h-full"
                                loading="lazy"
                              />
                            ) : null}
                          </div>
                          <span class="text-sm text-club-secondary truncate flex-1">
                            {m.isHome ? "vs" : "@"} {opponent.name}
                          </span>
                          <span class="text-[10px] font-display uppercase tracking-wider text-club-muted flex-shrink-0">
                            {m.isHome ? "Doma" : "Gosti"}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}

              {results.length > 0 && (
                <div>
                  <h3 class="text-lg mb-3">Odigrano</h3>
                  <ul class="space-y-2">
                    {results.slice(0, 8).map((m) => {
                      const opponent = m.isHome ? m.away : m.home;
                      const ours = m.isHome ? m.score!.home : m.score!.away;
                      const theirs = m.isHome ? m.score!.away : m.score!.home;
                      const outcome = (m.result ?? "D") as "W" | "D" | "L";
                      return (
                        <li class="bg-white border border-club-border rounded-lg px-3 py-3 flex items-center gap-3">
                          <span
                            class={`flex-shrink-0 w-7 h-7 rounded-full ${outcomeColor[outcome]} text-white font-display font-bold text-xs flex items-center justify-center`}
                            title={outcomeTitle[outcome]}
                          >
                            {outcomeLetter[outcome]}
                          </span>
                          <span class="text-sm text-club-secondary truncate flex-1">
                            {m.isHome ? "vs" : "@"} {opponent.name}
                          </span>
                          <span class="font-display font-bold text-club-primary-deep whitespace-nowrap">
                            {ours} : {theirs}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )}

              {upcoming.length === 0 && results.length === 0 && (
                <p class="text-sm text-club-muted bg-club-light/30 rounded-lg py-6 text-center">
                  Raspored još nije objavljen.
                </p>
              )}
            </div>

            {/* Ljestvica */}
            {comp.table.length > 0 && (
              <div>
                <h3 class="text-lg mb-3">Ljestvica</h3>
                <LeagueTable rows={comp.table} title={comp.name} />
              </div>
            )}
          </div>

          {/* Statistika — HNS je objavi tek nakon prvih odigranih utakmica,
              pa se cijeli blok do tad ne renderira. */}
          {hasStats(comp.stats) && (() => {
            const items = rankingItems(comp.stats);
            return (
              <div class="mt-10">
                <h3 class="text-lg mb-1">Statistika</h3>
                <p class="text-sm text-club-muted mb-4">
                  Prema podacima HNS Semafora za {comp.name}.
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  <StatRanking
                    title="Strijelci"
                    subtitle="Najbolji strijelci"
                    items={items.scorers}
                    valueLabel="Golovi"
                    emptyText="Još nema postignutih golova."
                  />
                  <StatRanking
                    title="Kartoni"
                    subtitle="Najviše opomena"
                    items={items.cards}
                    valueLabel="Žuti / Crveni"
                    emptyText="Još nema kartona."
                  />
                  <StatRanking
                    title="Nastupi"
                    subtitle="Najveći broj nastupa"
                    items={items.apps}
                    valueLabel="Nastupi"
                    emptyText="Još nema zabilježenih nastupa."
                  />
                </div>
              </div>
            );
          })()}
        </div>
      );
    })}

    <!-- Poznati igrači -->
    <div class="bg-gradient-to-br from-club-primary-deep to-club-primary text-white rounded-lg p-8 md:p-10 mb-10">
      <h2 class="text-3xl mb-6 text-white">Poznati igrači</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <article class="flex flex-col">
          <img
            src={url("/images/poznatiigraci/katarinapranjes.png")}
            alt="Katarina Pranješ"
            class="w-32 h-32 rounded-full object-cover ring-2 ring-club-accent mb-4"
            loading="lazy"
          />
          <h3 class="text-xl mb-2 text-white">Katarina Pranješ</h3>
          <p class="text-white/90 leading-relaxed">
            Karijeru je započela 2014. u NK Omladinac Niza kao članica Dječje športske akademije
            "Niza" — <strong>prva registrirana ženska igračica u povijesti kluba</strong>.
            Nakon uspješne pionirske sezone 2015/16., uočili su je skauti ŽNK Osijek, gdje
            osvaja titulu državnog prvaka 2017/18. Nastupala je za hrvatske U-16, U-17 i U-19
            reprezentacije, a u jesen 2020. debitira za seniorsku reprezentaciju Hrvatske
            protiv Litve. Od 2021. do 2023. nosi dres ŽNK Split, a od sezone 2023/24. članica
            je austrijskog <strong>LASK Linza</strong>.
          </p>
        </article>
        <article class="flex flex-col">
          <img
            src={url("/images/poznatiigraci/janadzic.png")}
            alt="Jan Adžić"
            class="w-32 h-32 rounded-full object-cover ring-2 ring-club-accent mb-4"
            loading="lazy"
          />
          <h3 class="text-xl mb-2 text-white">Jan Adžić</h3>
          <p class="text-white/90 leading-relaxed">
            Nogometnu karijeru započeo je u sezoni 2016/17. u Dječjoj športskoj akademiji
            "Niza", u kategorijama prednatjecatelja i početnika. Danas brani boje
            <strong>NK Osijeka</strong> kao golman.
          </p>
        </article>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-club-light border-l-4 border-club-primary p-6 rounded">
      <h3 class="text-xl mb-2">Želiš se priključiti?</h3>
      <p class="text-club-secondary/80 mb-4">
        Pošalji nam poruku na Facebooku ili dođi na trening na
        <strong>ŠRC Miroslav Knežević-Bujdo</strong> — rado ćemo te dočekati!
      </p>
      <a
        href="https://www.facebook.com/omladinacniza"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-club-primary text-white px-5 py-2.5 rounded-lg font-medium hover:bg-club-primary-deep transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Kontaktiraj nas na Facebooku
      </a>
    </div>
  </section>
</BaseLayout>
