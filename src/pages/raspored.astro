---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import UpcomingCard from "../components/UpcomingCard.astro";
import ResultCard from "../components/ResultCard.astro";
import { url } from "../lib/url";
import hns from "../data/hns.json";
import {
  allMatches,
  upcoming,
  played,
  typeLabel,
  typeOrder,
  typeSlug,
  countByType,
  competitionShort,
  ourScorers,
  shortDate,
} from "../lib/matches";

const matchDetails = (hns.matchDetails ?? {}) as Record<string, unknown>;

const competitionName = hns.competition?.name ?? "Sezona";

// webcal:// natjera kalendar da se PRETPLATI umjesto da jednom preuzme datoteku.
// Google i Apple tu adresu povremeno sami ponovo dohvate.
const icsPath = url("/raspored.ics");
const icsAbsolute = new URL(icsPath, Astro.site ?? "https://omladinacniza.hr").href;
const icsWebcal = icsAbsolute.replace(/^https?:/, "webcal:");

const lastUpdated = new Date(hns.lastUpdated).toLocaleString("hr-HR", {
  dateStyle: "short",
  timeStyle: "short",
  timeZone: "Europe/Zagreb",
});

// Filter po natjecanju — prikazujemo samo tipove kojih stvarno ima.
// Ako klub igra samo ligu, filter nema smisla pa se uopće ne renderira.
const counts = countByType(allMatches);
const filters = [
  { slug: "sve", type: "", label: "Sve", count: allMatches.length },
  ...typeOrder
    .filter((t) => counts[t] > 0)
    .map((t) => ({
      slug: typeSlug[t],
      type: t,
      label: typeLabel[t],
      count: counts[t],
    })),
];
const showFilters = filters.length > 2;

---

<BaseLayout
  title="Raspored"
  description={`Pun raspored utakmica NK Omladinac Niza u ${competitionName}. Datumi, vremena, suparnici, rezultati.`}
>
  <Hero
    title="Raspored"
    subtitle={`Sve utakmice — ${competitionName}`}
    height="md"
  />

  <section class="container-narrow mt-12">
    {/* Cijeli raspored u kalendar */}
    <div
      class="bg-club-light-2 border border-club-border rounded-lg p-4 md:p-5 mb-8 flex flex-col sm:flex-row sm:items-center gap-4"
    >
      <svg
        class="w-8 h-8 text-club-primary flex-shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <div class="flex-1 min-w-0">
        <p class="font-display font-bold uppercase tracking-wider text-sm text-club-primary-deep">
          Cijeli raspored u tvom kalendaru
        </p>
        <p class="text-sm text-club-muted mt-0.5">
          Sve utakmice odjednom — liga, kup i prijateljske. Ako se
          <strong>pretplatiš</strong>, promjene termina i nove utakmice stižu same.
        </p>
      </div>
      <div class="flex gap-2 flex-shrink-0">
        <a href={icsWebcal} class="btn-primary text-sm whitespace-nowrap" data-umami-event="Pretplata na raspored">
          Pretplati se
        </a>
        {/* btn-outline je bijeli (za hero), pa na svijetloj podlozi treba svoja boja */}
        <a
          href={icsPath}
          download="omladinac-raspored.ics"
          data-umami-event="Preuzmi raspored"
          class="inline-flex items-center justify-center px-6 py-3 rounded font-display text-sm font-bold uppercase tracking-widest text-club-primary-deep bg-white border-2 border-club-primary hover:bg-club-primary hover:text-white transition-colors whitespace-nowrap"
        >
          Preuzmi
        </a>
      </div>
    </div>

    {/* Sažetak sezone */}
    <div class="grid grid-cols-3 gap-3 md:gap-6 mb-10">
      <div class="bg-white border border-club-border rounded-lg p-4 text-center">
        <p class="font-display font-bold text-3xl md:text-4xl text-club-primary-deep">
          {allMatches.length}
        </p>
        <p class="text-xs md:text-sm text-club-muted mt-1">utakmica u sezoni</p>
      </div>
      <div class="bg-white border border-club-border rounded-lg p-4 text-center">
        <p class="font-display font-bold text-3xl md:text-4xl text-club-primary">
          {played.length}
        </p>
        <p class="text-xs md:text-sm text-club-muted mt-1">odigrano</p>
      </div>
      <div class="bg-white border border-club-border rounded-lg p-4 text-center">
        <p class="font-display font-bold text-3xl md:text-4xl text-club-accent">
          {upcoming.length}
        </p>
        <p class="text-xs md:text-sm text-club-muted mt-1">preostalo</p>
      </div>
    </div>

    {/* Filter po natjecanju */}
    {showFilters && (
      <div
        id="type-filter"
        class="flex flex-wrap gap-2 mb-8"
        role="group"
        aria-label="Filtriraj utakmice po natjecanju"
      >
        {filters.map((f) => (
          <button
            type="button"
            data-filter={f.slug}
            data-type={f.type}
            aria-pressed={f.slug === "sve" ? "true" : "false"}
            class="filter-btn px-4 py-2 rounded-full border-2 font-display text-xs uppercase tracking-wider transition-colors border-club-border bg-white text-club-secondary hover:border-club-primary aria-pressed:bg-club-primary aria-pressed:border-club-primary aria-pressed:text-white"
          >
            {f.label}
            <span class="ml-1.5 opacity-60">{f.count}</span>
          </button>
        ))}
      </div>
    )}

    {/* PREDSTOJEĆE */}
    <div class="mb-12" data-section="upcoming">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-2xl">Predstojeće utakmice</h2>
        <span
          class="text-xs font-display uppercase tracking-wider text-club-muted"
          data-count-label
        >
          {upcoming.length} utakmica
        </span>
      </div>

      {/* Prazno stanje kad filter ne pogodi nijednu utakmicu */}
      <div
        data-filter-empty
        style="display: none"
        class="bg-club-light border-l-4 border-club-primary p-6 rounded text-center"
      >
        <p class="text-club-secondary/80">
          Nema predstojećih utakmica u odabranom natjecanju.
        </p>
      </div>

      {upcoming.length === 0 ? (
        <div class="bg-club-light border-l-4 border-club-primary p-6 rounded text-center">
          <p class="text-club-secondary/80">
            Nema više utakmica u ovoj sezoni — sezona je završena.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {upcoming.map((m) => (
            <UpcomingCard match={m} label={competitionShort(m)} withPreview matchType={m.type} />
          ))}
        </div>
      )}
    </div>

    {/* ODIGRANE */}
    {played.length > 0 && (
      <div data-section="played">
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="text-2xl">Odigrane utakmice</h2>
          <span
            class="text-xs font-display uppercase tracking-wider text-club-muted"
            data-count-label
          >
            {played.length} odigrano
          </span>
        </div>

        <div
          data-filter-empty
          style="display: none"
          class="bg-club-light border-l-4 border-club-primary p-6 rounded text-center"
        >
          <p class="text-club-secondary/80">
            Nema odigranih utakmica u odabranom natjecanju.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {played.map((m) => {
            const hasDetail = !!matchDetails[m.id];
            return (
              <ResultCard
                match={m}
                label={competitionShort(m)}
                date={shortDate(m.date)}
                note={ourScorers(m)}
                href={hasDetail ? url(`/utakmica/${m.id}`) : m.url}
                external={!hasDetail && !!m.url}
                matchType={m.type}
              />
            );
          })}
        </div>
      </div>
    )}

    <p class="text-center text-xs text-club-muted mt-12">
      Podaci dohvaćeni s
      <a
        href={hns.sourceUrl || "https://semafor.hns.family/"}
        target="_blank"
        rel="noopener"
        class="hover:text-club-primary underline"
      >
        HNS Semafora
      </a>
      · podaci od {lastUpdated}
    </p>
  </section>

  <script>
    // ── Filter po natjecanju (liga / kup / prijateljske) ───────────────
    // Sve utakmice su već u HTML-u; filter samo skriva one koje ne odgovaraju,
    // pa nema ni reloada ni drugog dohvata.

    /** 1 utakmica · 2 utakmice · 5 utakmica */
    function utakmicaLabel(n: number): string {
      const mod10 = n % 10;
      const mod100 = n % 100;
      if (mod100 >= 11 && mod100 <= 14) return "utakmica";
      if (mod10 === 1) return "utakmica";
      if (mod10 >= 2 && mod10 <= 4) return "utakmice";
      return "utakmica";
    }

    /** `slug` je iz URL-a ("liga", "kup", "prijateljske", "sve"). */
    function applyFilter(slug: string) {
      const active = document.querySelector<HTMLButtonElement>(
        `.filter-btn[data-filter="${CSS.escape(slug)}"]`,
      );
      const type = active?.dataset.type || "";

      document.querySelectorAll<HTMLElement>("[data-section]").forEach((section) => {
        const cards = section.querySelectorAll<HTMLElement>("[data-match-type]");
        let visible = 0;

        cards.forEach((card) => {
          const show = !type || card.dataset.matchType === type;
          // NE koristimo `hidden` atribut — Tailwind `block` na odigranim
          // karticama ima veću specifičnost od preflight `[hidden]` pravila
          // pa bi kartice ostale vidljive.
          card.style.display = show ? "" : "none";
          if (show) visible++;
        });

        // Prazno stanje se prikazuje samo kad je filter sve odrezao,
        // a ne kad sekcija ionako nema utakmica (tu već postoji svoja poruka).
        const empty = section.querySelector<HTMLElement>("[data-filter-empty]");
        if (empty) {
          empty.style.display = cards.length > 0 && visible === 0 ? "" : "none";
        }

        const label = section.querySelector<HTMLElement>("[data-count-label]");
        if (label) {
          label.textContent =
            section.dataset.section === "played"
              ? `${visible} odigrano`
              : `${visible} ${utakmicaLabel(visible)}`;
        }
      });

      document.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.dataset.filter === slug));
      });
    }

    function setupFilter() {
      const group = document.getElementById("type-filter");
      if (!group) return;

      group.querySelectorAll<HTMLButtonElement>(".filter-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const slug = btn.dataset.filter || "sve";
          applyFilter(slug);
          // Hash čuva izbor kroz reload i omogućuje dijeljenje linka (/raspored#kup)
          history.replaceState(null, "", slug === "sve" ? location.pathname : `#${slug}`);
        });
      });

      const fromHash = decodeURIComponent(location.hash.replace("#", ""));
      const valid = [...group.querySelectorAll<HTMLButtonElement>(".filter-btn")].some(
        (b) => b.dataset.filter === fromHash,
      );
      applyFilter(valid ? fromHash : "sve");
    }

    // ClientRouter ne pokreće <script> ponovo pri navigaciji — veži na page-load.
    document.addEventListener("astro:page-load", setupFilter);
  </script>
</BaseLayout>
