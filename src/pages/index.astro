---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import NextMatchCard from "../components/NextMatchCard.astro";
import YouthMatchCard from "../components/YouthMatchCard.astro";
import YouthSignup from "../components/YouthSignup.astro";
import LastMatchCard from "../components/LastMatchCard.astro";
import MatchDayHero from "../components/MatchDayHero.astro";
import LeagueTable from "../components/LeagueTable.astro";
import SeasonStats from "../components/SeasonStats.astro";
import RecentResults from "../components/RecentResults.astro";
import LatestPostBlock from "../components/LatestPostBlock.astro";
import SchemaSportsTeam from "../components/SchemaSportsTeam.astro";
import hns from "../data/hns.json";
import { url } from "../lib/url";
import { pluralCroatian } from "../lib/croatian";
import { sportsEventLd } from "../lib/schema";
import {
  nextMatch,
  nextYouthMatch,
  played,
  todayInZagreb,
  daysFromToday,
  competitionShort,
  matchBadge,
  type LeagueRow,
  type UnifiedMatch,
} from "../lib/matches";

const table = hns.table as LeagueRow[];

// Godine tradicije iz godine osnutka — dnevni build ih sam osvježi u siječnju.
const FOUNDED = 1963;
const clubAge = Number(todayInZagreb.slice(0, 4)) - FOUNDED;
const decadeWord =
  ["", "jedno", "dva", "tri", "četiri", "pet", "šest", "sedam", "osam", "devet"][
    Math.floor(clubAge / 10)
  ] ?? String(Math.floor(clubAge / 10));
const decadesText = `${clubAge % 10 === 0 ? "Punih" : "Više od"} ${decadeWord} desetljeća`;

// U-11 na naslovnici samo kad igraju u idućih tjedan dana ("ovaj vikend").
const youthMatch =
  nextYouthMatch && daysFromToday(nextYouthMatch.date) <= 7 ? nextYouthMatch : null;
const lastMatch = played[0] ?? null;
const hasSide = !!youthMatch || !!lastMatch;

// schema.org SportsEvent za sljedeću utakmicu; URL vodi na njezinu najavu.
const site = Astro.site ?? new URL("https://omladinacniza.hr");
const nextMatchLd = nextMatch
  ? sportsEventLd(nextMatch, new URL(url(`/najava/${nextMatch.id}`), site).href, site)
  : null;

// Sljedeći protivnik u ligi — ističe se u tablici.
const nextOpponentId =
  nextMatch?.type === "league"
    ? nextMatch.isHome
      ? nextMatch.away.id
      : nextMatch.home.id
    : null;

// ── Match-day banneri ─────────────────────────────────────────────────
// Po jedan za sljedeću utakmicu svake ekipe kojoj znamo vrijeme početka
// (prijateljske ga ponekad nemaju — tada ostaje samo kartica). Koji je
// vidljiv odlučuje skripta u MatchDayHero; `visible` je samo početno stanje
// prema datumu builda (Europe/Zagreb).
type HeroItem = { match: UnifiedMatch; team: string; label: string };
const heroItems: HeroItem[] = [
  nextMatch && {
    match: nextMatch,
    team: "Seniori",
    label: `Seniori · ${competitionShort(nextMatch)}`,
  },
  nextYouthMatch && {
    match: nextYouthMatch,
    team: "Početnici U-11",
    label: `Početnici U-11 · ${matchBadge(nextYouthMatch)}`,
  },
]
  .filter((h): h is HeroItem => !!h && !!h.match.time)
  .sort((a, b) => a.match.iso.localeCompare(b.match.iso));

const initialHero = heroItems.find((h) => h.match.date === todayInZagreb) ?? null;

/** "Danas još: Seniori u 18:00, u gostima kod NK Iskrica" — kasnije utakmice istog dana. */
function alsoToday(item: HeroItem): string | null {
  const later = heroItems.filter(
    (o) => o !== item && o.match.date === item.match.date && o.match.iso > item.match.iso,
  );
  if (!later.length) return null;
  const parts = later.map(({ match: m, team }) => {
    const where = m.isHome ? `doma protiv ${m.away.name}` : `u gostima kod ${m.home.name}`;
    return `${team} u ${m.time}, ${where}`;
  });
  return `Danas još: ${parts.join(" · ")}`;
}
---

<BaseLayout
  title="NK Omladinac Niza"
  description="Službena web stranica nogometnog kluba NK Omladinac Niza - rezultati, tablica, momčad i sve novosti iz kluba."
>
  <SchemaSportsTeam slot="head" />
  {
    nextMatchLd && (
      <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(nextMatchLd)} />
    )
  }

  {/* Najava turnira ide ovdje dok traje, npr.
      <TurnirBanner href={url("/turnir/penali")} kicker="…" title="…" meta="…" until="…" />
      Sama nestane nakon `until`; kad prođe, obriši je i stavku iz Header.astro. */}

  {/* Match-day hero — vidljiv samo na dan utakmice */}
  {
    heroItems.map((item) => (
      <MatchDayHero
        match={item.match}
        label={item.label}
        visible={item === initialHero}
        alsoToday={alsoToday(item)}
      />
    ))
  }

  <Hero
    title="Omladinac Niza"
    subtitle="Tradicija, strast i nogomet u našoj zajednici"
  >
    <div class="flex flex-wrap gap-3 mt-8">
      <a href={url("/momcad")} class="btn-primary">Upoznaj momčad</a>
      <a href={url("/klub")} class="btn-outline">O klubu</a>
    </div>
  </Hero>

  {/* Utakmice — flotiraju preko hero ruba. Lijevo sljedeća seniorska s
      usporedbom, desno U-11 (ako igraju ovaj tjedan) i zadnji rezultat.
      Na dan utakmice ostaju vidljive: usporedba forme nije u banneru. */}
  <section class="container-narrow -mt-20 relative z-10">
    <div class={`grid gap-4 md:gap-6 items-start ${hasSide ? "lg:grid-cols-3" : ""}`}>
      <div class={hasSide ? "lg:col-span-2" : ""}>
        <NextMatchCard
          match={nextMatch}
          table={table}
          sharePath={nextMatch ? `/najava/${nextMatch.id}` : undefined}
        />
      </div>
      {
        hasSide && (
          <div
            class={`grid gap-4 md:gap-6 ${
              youthMatch && lastMatch ? "sm:grid-cols-2 lg:grid-cols-1" : ""
            }`}
          >
            {youthMatch && <YouthMatchCard match={youthMatch} />}
            {lastMatch && <LastMatchCard match={lastMatch} />}
          </div>
        )
      }
    </div>
  </section>

  {/* Prvo sportski sadržaj (tablica, rezultati), a tek onda Facebook — zadnja
      objava zna biti obavijest koja s nogometom nema veze. */}

  <SeasonStats />

  <!-- Tablica (cijela) -->
  <section class="container-narrow mt-16">
    <h2 class="text-2xl mb-4">Tablica</h2>
    <LeagueTable highlightId={nextOpponentId} />
  </section>

  <!-- Zadnji rezultati ispod tablice u 2 stupca. Najnoviji je već u kartici
       "Zadnja utakmica" gore, pa se ovdje preskače. -->
  <section class="container-narrow mt-12">
    <h2 class="text-2xl mb-4">Zadnji rezultati</h2>
    <RecentResults limit={6} skip={lastMatch ? 1 : 0} grid={true} />
  </section>

  <!-- Upis u školu nogometa -->
  <section class="container-narrow mt-12">
    <YouthSignup compact />
  </section>

  <!-- Najnovija objava s Facebooka (pinned) -->
  <LatestPostBlock />

  <!-- O klubu CTA -->
  <section class="container-narrow mt-20">
    <div
      class="bg-club-secondary text-white rounded-lg p-8 md:p-12 grid md:grid-cols-2 gap-8 items-center overflow-hidden relative"
    >
      <div
        class="absolute -right-20 -top-20 w-64 h-64 rounded-full bg-club-primary opacity-20"
      >
      </div>
      <div class="relative">
        <h2 class="text-3xl md:text-4xl mb-4">O klubu</h2>
        <p class="text-white/80 leading-relaxed mb-6">
          NK Omladinac Niza je nogometni klub iz mjesta Niza u Općini Koška, osnovan
          <strong class="text-club-accent">davne {FOUNDED}. godine</strong>. {decadesText}
          okupljamo generacije mladih oko ljubavi prema nogometu — od mladih
          nada koje su prošle kroz klub do seniorske momčadi koja danas brani naše boje.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={url("/klub")} class="btn-primary">Više o klubu</a>
          <a href={url("/povijest")} class="btn-outline">Povijest</a>
        </div>
      </div>
      <div class="relative grid grid-cols-2 gap-4">
        <div class="bg-white/5 backdrop-blur rounded-lg p-6 text-center">
          <p class="font-display text-4xl font-bold text-club-accent">{clubAge}</p>
          <p class="text-sm text-white/70 mt-1">
            {pluralCroatian(clubAge, "godina", "godine", "godina")} tradicije
          </p>
        </div>
        <div class="bg-white/5 backdrop-blur rounded-lg p-6 text-center">
          <p class="font-display text-4xl font-bold text-club-accent">100+</p>
          <p class="text-sm text-white/70 mt-1">djece kroz klub</p>
        </div>
        <div class="bg-white/5 backdrop-blur rounded-lg p-6 text-center">
          <p class="font-display text-4xl font-bold text-club-accent">6</p>
          <p class="text-sm text-white/70 mt-1">naslova prvaka</p>
        </div>
        <div class="bg-white/5 backdrop-blur rounded-lg p-6 text-center">
          <p class="font-display text-4xl font-bold text-club-accent">100</p>
          <p class="text-sm text-white/70 mt-1">sjedalica tribina</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
