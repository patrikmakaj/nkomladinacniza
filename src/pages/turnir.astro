---
/**
 * Turnir u boćanju na travi (25.07.2026.) — arhiva.
 *
 * Sva logika je u components/TurnirLive.astro + lib/turnir.ts; ovdje su samo
 * konfiguracija Sheeta i pravila ovog turnira.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TurnirLive from "../components/TurnirLive.astro";
import type { TurnirConfig } from "../lib/turnir";

// Google Sheet mora biti dijeljen: "Bilo tko s poveznicom → Preglednik".
const config: TurnirConfig = {
  sheetId: "1uSdnYjVSAiq5p0lN89gn7GBQPQrRbufqHHsNOENbl3s",
  tabs: { teams: "Parovi", matches: "Utakmice" },
  // Parovi: Grupa | Par (ekipa) | Igrač 1 | Igrač 2 | Kašnjenje | Kotizacija
  teamCols: { group: 0, name: 1, players: [2, 3] },
  // Utakmice: Redni | Faza | Grupa | Vrijeme | Teren | Domaćin | Gost | Boće D | Boće G
  matchCols: { redni: 0, faza: 1, grupa: 2, vrijeme: 3, teren: 4, home: 5, away: 6, scoreHome: 7, scoreAway: 8 },
  courts: 2,
  unit: { label: "Boće", totalLabel: "Ukupno boća", mostLabel: "Najviše osvojenih boća", countWord: "boća" },
  teamWord: "Par",
  playersLabel: "Igrači (par)",
  start: "2026-07-25T17:00:00",
  followKey: "bocanje_follow",
  qualifiersPerGroup: 2,
};
---

{/* Jednokratni događaj — nije u navigaciji i ne treba biti u tražilicama.
    Stranica i dalje radi na direktan link; kad se turnir ponovi, makni
    `noIndex` ovdje i /turnir iz EXCLUDED u astro.config.mjs. */}
<BaseLayout
  title="Turnir u boćanju"
  description="Rezultati uživo — Turnir u boćanju na travi, DŠA Niza, igralište u Nizi. Grupne tablice, raspored, eliminacija u stvarnom vremenu."
  noIndex
>
  <TurnirLive
    title="Turnir u boćanju na travi"
    subtitle="DŠA Niza · Subota 25.07. od 17:00 · Igralište u Nizi"
    config={config}
    registrationNote="Ždrijeb grupa i raspored u subotu (25.07.) nakon 17:00. Klikni ekipu za igrače."
    groupsNote="Kod jednakog broja pobjeda: međusobni susret → razlika boća → osvojene boće."
  >
    <Fragment slot="pravila">
    <p class="text-[#64748B] mb-4">Turnir u boćanju na travi · DŠA Niza · igralište u Nizi</p>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">1. Format natjecanja</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li>Igra se <strong>u parovima</strong> (2 igrača po ekipi).</li>
      <li>Ekipe se ždrijebom raspoređuju u <strong>4 grupe</strong>.</li>
      <li>U grupi se igra <strong>svako sa svakim</strong> (jedan meč).</li>
      <li>Iz svake grupe prolaze <strong>prve dvije ekipe</strong> → ukupno <strong>8 ekipa</strong> u eliminaciju.</li>
      <li>Eliminacija: <strong>četvrtfinale → polufinale → finale</strong>, uz meč <strong>za 3. mjesto</strong>.</li>
      <li>Igra se na <strong>2 terena paralelno</strong>; svaki meč traje <strong>okvirno 20 min</strong>.</li>
      <li>Kotizacija: <strong>10 € po paru</strong>. Nagrade/trofeji za <strong>prva tri mjesta</strong>.</li>
    </ul>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">2. Bodovanje meča</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li>Meč se igra <strong>do 11 boća (bodova)</strong>.</li>
      <li>Kod izjednačenja <strong>10:10 igra se na dvije razlike</strong> (npr. 12:10, 13:11) — nema neriješenih, samo pobjeda/poraz.</li>
      <li>Pobjednik je ekipa koja prva dosegne 11 uz razliku od najmanje dvije na kraju.</li>
    </ul>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">3. Kako se osvajaju boće</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li>Cilj je <strong>svoje boće dobaciti bliže bulinu</strong> (cilju) nego protivnik.</li>
      <li>U svakom krugu bodove osvaja <strong>samo jedna ekipa</strong> — ona čija je boća najbliža bulinu.</li>
      <li>Osvaja <strong>onoliko bodova koliko ima svojih boća bližih</strong> od najbliže protivničke boće.</li>
      <li>Svaki par igra sa <strong>4 boće</strong> (2 po igraču).</li>
      <li>Ako ekipa u jednom bacanju ima <strong>sve 4 boće bliže bulinu</strong> od protivnika, osvaja <strong>8 bodova (dvostruko)</strong> umjesto 4.</li>
    </ul>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">4. Tijek igre</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li>Bacanjem novčića ili dogovorom određuje se ekipa koja prva baca <strong>bulin</strong>.</li>
      <li>Ta ekipa baca bulin, zatim svoju prvu boću.</li>
      <li>Dalje baca <strong>ekipa koja NIJE najbliža</strong> bulinu, dok ne potroši boće; tada baca druga ekipa.</li>
      <li>Kad su sve boće bačene, mjeri se i pribrajaju bodovi.</li>
      <li>Sljedeći krug <strong>prva baca ekipa koja je osvojila bodove</strong> u prethodnom.</li>
      <li><strong>Bulin i protivničke boće smiju se izbijati.</strong></li>
    </ul>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">5. Teren i bacanje</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li>Baca se <strong>iza označene linije</strong>; prijelaz/gaženje linije za bacanje = prekršaj (boća se poništava).</li>
      <li>Igra se <strong>do zadnje crte</strong> terena.</li>
      <li>Boća koja <strong>izađe iz granica terena više se ne računa</strong> (izbacuje se iz igre).</li>
      <li>Boća koja <strong>dodiruje liniju i dalje se računa</strong> (ostaje u igri).</li>
      <li>Bulin se baca na udaljenost <strong>otprilike 6–10 m</strong> i mora ostati unutar granica terena.</li>
      <li>Ako bulin izađe iz terena — baca se ponovno.</li>
    </ul>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">6. Mjerenje i sporne situacije</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li>Kod bliskih boća <strong>mjeri se</strong> (metar/špaga).</li>
      <li>Ako se ne može odlučiti čija je boća bliža za bod — taj se bod <strong>poništava</strong>.</li>
      <li>Sve <strong>sporne odluke rješava sudac/organizator</strong> i njegova je odluka konačna.</li>
    </ul>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">7. Poredak u grupi</h3>
    <p>Kod jednakog broja pobjeda redoslijed određuje: <strong>1) međusobni susret</strong>, <strong>2) razlika boća</strong> (osvojene − primljene), <strong>3) ukupno osvojene boće</strong>.</p>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">8. Raspored i satnica</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li>Raspored i rezultati uživo: <strong>omladinacniza.hr/turnir</strong>.</li>
      <li>Vremena su <strong>okvirna</strong> (~20 min po meču) i mogu se pomicati ovisno o tijeku.</li>
      <li>Ekipa koja se ne pojavi na terenu u roku <strong>5 min</strong> od poziva gubi meč bez borbe (0:11).</li>
    </ul>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">9. Ponašanje i fair play</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li>Očekuje se <strong>sportsko ponašanje</strong> prema protivnicima, sucima i organizatorima.</li>
      <li>Grubo nesportsko ponašanje = <strong>opomena ili diskvalifikacija</strong> ekipe.</li>
      <li>Konzumacija pića dopuštena je uz sportsko ponašanje i bez ometanja tijeka igre.</li>
    </ul>

    <h3 class="font-display font-bold text-[#10275c] uppercase tracking-wide mt-4 mb-1">10. Završne odredbe</h3>
    <ul class="list-disc pl-5 space-y-1">
      <li><strong>Organizator (DŠA Niza)</strong> zadržava pravo izmjene rasporeda i pravila prije početka turnira.</li>
      <li>Sudjelovanjem ekipe prihvaćaju ova pravila.</li>
    </ul>
    </Fragment>
  </TurnirLive>
</BaseLayout>
