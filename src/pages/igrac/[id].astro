---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { photoSrc } from "../../lib/images";
import ResultCard from "../../components/ResultCard.astro";
import { golLabel, nastupLabel } from "../../lib/croatian";
import { url } from "../../lib/url";
import hns from "../../data/hns.json";
import {
  competitionShort,
  shortDate,
  badgeClass,
  typeLabel,
  typeOrder,
  type MatchType,
  type UnifiedMatch,
} from "../../lib/matches";

const OUR_CLUB_ID = 134;

type Player = {
  id: number;
  number: number | null;
  name: string;
  position: string | null;
  photo: string | null;
  profileUrl: string | null;
};

type LineupPlayer = {
  personId: number | null;
  number: number | null;
  name: string;
  position: string | null;
  captain: boolean;
  photo: string | null;
  events: { type: string; minute: number | null; label: string | null }[];
};

type Match = {
  id: string;
  round: number | null;
  date: string;
  iso: string;
  /** Nedostaje u starijim verzijama hns.json — fallback na "league". */
  type?: MatchType;
  competition?: string;
  competitionId?: number | null;
  home: { id: number; name: string; logo: string | null };
  away: { id: number; name: string; logo: string | null };
  score: { home: number; away: number } | null;
  played: boolean;
  result: "W" | "D" | "L" | null;
};

export async function getStaticPaths() {
  const players = (hns.players ?? []) as Player[];
  return players.map((p) => ({ params: { id: String(p.id) } }));
}

const { id } = Astro.params;
const personId = Number(id);

const player = (hns.players as Player[]).find((p) => p.id === personId);

if (!player) {
  return Astro.redirect(url("/momcad"));
}

const matches = (hns.matches as Match[]) ?? [];
const matchDetails = (hns.matchDetails ?? {}) as Record<string, any>;

type PlayerMatchEntry = {
  match: Match;
  ourSide: "home" | "away";
  isStarter: boolean;
  events: LineupPlayer["events"];
  goals: number;
  yellow: number;
  red: number;
};

const appearances: PlayerMatchEntry[] = [];

for (const match of matches) {
  if (!match.played || !match.score) continue;
  const detail = matchDetails[match.id];
  if (!detail) continue;

  const ourSide: "home" | "away" =
    match.home.id === OUR_CLUB_ID ? "home" : "away";
  const ourLineup = detail.lineup?.[ourSide];
  if (!ourLineup) continue;

  const starters = (ourLineup.starters ?? []) as LineupPlayer[];
  const subs = (ourLineup.subs ?? []) as LineupPlayer[];

  const inStarters = starters.find((p) => p.personId === personId);
  const inSubs = subs.find((p) => p.personId === personId);
  const found = inStarters ?? inSubs;
  if (!found) continue;

  const evs = found.events ?? [];
  const goals = evs.filter(
    (e) => e.type === "goal" || e.type === "penalty"
  ).length;
  const yellow = evs.filter((e) => e.type === "yellow").length;
  const red = evs.filter((e) => e.type === "red").length;

  appearances.push({
    match,
    ourSide,
    isStarter: !!inStarters,
    events: evs,
    goals,
    yellow,
    red,
  });
}

// Najnoviji prvi
appearances.sort((a, b) => b.match.iso.localeCompare(a.match.iso));

const totalAppearances = appearances.length;
const totalGoals = appearances.reduce((s, a) => s + a.goals, 0);
const totalYellow = appearances.reduce((s, a) => s + a.yellow, 0);
const totalRed = appearances.reduce((s, a) => s + a.red, 0);

// ── Razdvajanje po natjecanju ─────────────────────────────────────────
// Igrač nastupa u ligi i kupu, a kartice gore prikazuju zbroj. Ovdje se vidi
// koliko je od toga koje natjecanje. Brojke se izvode iz istih nastupa kao i
// popis utakmica ispod, pa ne mogu razići jedne od drugih.

/** "Kup NS Našice 26/27, 1/16 finala" → "Kup NS Našice 26/27" */
function competitionName(c: string | undefined): string {
  return (c || "").split(",")[0].trim();
}

type CompetitionStats = {
  key: string;
  name: string;
  type: MatchType;
  appearances: number;
  goals: number;
  yellow: number;
  red: number;
};

const byCompetition: CompetitionStats[] = [];
for (const a of appearances) {
  const type = (a.match.type ?? "league") as MatchType;
  const key = String(a.match.competitionId ?? type);
  let row = byCompetition.find((r) => r.key === key);
  if (!row) {
    row = {
      key,
      name: competitionName(a.match.competition) || typeLabel[type],
      type,
      appearances: 0,
      goals: 0,
      yellow: 0,
      red: 0,
    };
    byCompetition.push(row);
  }
  row.appearances++;
  row.goals += a.goals;
  row.yellow += a.yellow;
  row.red += a.red;
}
byCompetition.sort(
  (a, b) => typeOrder.indexOf(a.type) - typeOrder.indexOf(b.type),
);

// Kod jednog natjecanja razdvajanje ne govori ništa novo — kartice već sve kažu.
const showBreakdown = byCompetition.length > 1;
const firstAppearance = appearances[appearances.length - 1]?.match;
const matchesWithGoals = appearances.filter((a) => a.goals > 0).length;

const initials = player.name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();

function formatShortDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("hr-HR", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
}

/** Igračeva utakmica u jednom retku: "⚽ 67' · 🟨 85' · pričuva". */
function playerNote(a: PlayerMatchEntry): string {
  const events = a.events
    .filter((ev) => ev.type !== "other")
    .map((ev) => `${eventIcon(ev.type)}${ev.minute != null ? ` ${ev.minute}'` : ""}`);
  return [...events, a.isStarter ? null : "pričuva"].filter(Boolean).join(" · ");
}

function eventIcon(t: string): string {
  switch (t) {
    case "goal":
    case "penalty":
      return "⚽";
    case "own_goal":
      return "🥅";
    case "yellow":
      return "🟨";
    case "red":
      return "🟥";
    case "subin":
      return "🔼";
    case "subout":
      return "🔽";
    default:
      return "•";
  }
}

const positionGroup = (player.position || "")
  .toLowerCase()
  .includes("vratar")
  ? "Vratar"
  : "Igrač";

const pageTitle = player.name;
const pageDescription = `Profil igrača ${player.name} u sezoni ${hns.competition?.season ?? ""} — golovi, nastupi, kartoni i sve utakmice kroz ligu i kup.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {/* Hero */}
  <section class="relative bg-club-primary text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <img
        src={url("/images/logo.svg")}
        alt=""
        width="500"
        height="500"
        class="absolute -right-16 top-1/2 -translate-y-1/2 w-[400px] h-auto"
      />
    </div>

    <div class="relative container-narrow py-8 md:py-12">
      <a
        href={url("/momcad")}
        class="inline-flex items-center gap-1.5 text-xs font-display uppercase tracking-wider text-white/70 hover:text-white mb-6 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Natrag na momčad
      </a>

      <div class="flex items-center gap-6 md:gap-8">
        {/* Foto */}
        <div class="flex-shrink-0 w-28 h-28 md:w-40 md:h-40 rounded-lg bg-white/10 border-2 border-white/30 overflow-hidden flex items-center justify-center">
          {player.photo ? (
            <img
              src={photoSrc(player.photo)}
              alt={player.name}
              class="w-full h-full object-cover object-top"
            />
          ) : (
            <span class="font-display font-bold text-3xl md:text-5xl text-white/70">
              {initials}
            </span>
          )}
        </div>

        {/* Info */}
        <div class="flex-1 min-w-0">
          {player.number != null && (
            <p class="font-display font-bold text-club-accent text-3xl md:text-5xl leading-none mb-2">
              #{player.number}
            </p>
          )}
          <h1 class="font-display font-bold text-2xl md:text-4xl uppercase tracking-tight leading-tight">
            {player.name}
          </h1>
          {/* "Igrač" ne govori ništa (HNS drugo ne razlikuje) — piše se samo vratar */}
          {positionGroup === "Vratar" && (
            <p class="text-white/70 text-sm md:text-base mt-1">Vratar</p>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* Statistike sezone */}
  <section class="container-narrow mt-8 mb-12">
    <h2 class="text-xl font-display font-bold uppercase tracking-wider text-club-primary-deep mb-4">
      Sezona {hns.competition?.season ?? ""}
    </h2>
    <p class="text-sm text-club-muted -mt-3 mb-4">
      Zbrojeno kroz sva natjecanja.
    </p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      <div class="bg-white border border-club-border rounded-lg p-4 text-center">
        <p class="font-display font-bold text-3xl md:text-4xl text-club-primary-deep">
          {totalAppearances}
        </p>
        <p class="text-xs md:text-sm text-club-muted mt-1">
          {nastupLabel(totalAppearances)}
        </p>
      </div>
      <div class="bg-white border border-club-border rounded-lg p-4 text-center">
        <p class="font-display font-bold text-3xl md:text-4xl text-club-primary">
          {totalGoals}
        </p>
        <p class="text-xs md:text-sm text-club-muted mt-1">
          {golLabel(totalGoals)}
        </p>
      </div>
      <div class="bg-white border border-club-border rounded-lg p-4 text-center">
        <p class="font-display font-bold text-3xl md:text-4xl text-yellow-600 flex items-center justify-center gap-2">
          <span>🟨</span>
          <span>{totalYellow}</span>
        </p>
        <p class="text-xs md:text-sm text-club-muted mt-1">žuti kartoni</p>
      </div>
      <div class="bg-white border border-club-border rounded-lg p-4 text-center">
        <p class="font-display font-bold text-3xl md:text-4xl text-red-600 flex items-center justify-center gap-2">
          <span>🟥</span>
          <span>{totalRed}</span>
        </p>
        <p class="text-xs md:text-sm text-club-muted mt-1">crveni kartoni</p>
      </div>
    </div>

    {/* Razdvajanje po natjecanju */}
    {showBreakdown && (
      <div class="mt-6 bg-white border border-club-border rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-club-light-2 text-club-muted">
                <th
                  scope="col"
                  class="text-left font-display uppercase tracking-wider text-xs px-4 py-2.5"
                >
                  Natjecanje
                </th>
                <th scope="col" class="font-display uppercase tracking-wider text-xs px-3 py-2.5 text-center">
                  Nastupi
                </th>
                <th scope="col" class="font-display uppercase tracking-wider text-xs px-3 py-2.5 text-center">
                  Golovi
                </th>
                <th scope="col" class="font-display uppercase tracking-wider text-xs px-3 py-2.5 text-center">
                  🟨
                </th>
                <th scope="col" class="font-display uppercase tracking-wider text-xs px-3 py-2.5 text-center">
                  🟥
                </th>
              </tr>
            </thead>
            <tbody>
              {byCompetition.map((c) => (
                <tr class="border-t border-club-border">
                  <td class="px-4 py-3">
                    <span
                      class={`font-display font-bold uppercase tracking-wider text-[10px] px-2 py-0.5 rounded mr-2 ${badgeClass[c.type]}`}
                    >
                      {typeLabel[c.type]}
                    </span>
                    <span class="text-club-secondary">{c.name}</span>
                  </td>
                  <td class="px-3 py-3 text-center font-display font-bold text-club-primary-deep">
                    {c.appearances}
                  </td>
                  <td class="px-3 py-3 text-center font-display font-bold text-club-primary">
                    {c.goals}
                  </td>
                  <td class="px-3 py-3 text-center text-club-muted">{c.yellow}</td>
                  <td class="px-3 py-3 text-center text-club-muted">{c.red}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="border-t-2 border-club-border bg-club-light/30">
                <td class="px-4 py-3 font-display uppercase tracking-wider text-xs text-club-muted">
                  Ukupno
                </td>
                <td class="px-3 py-3 text-center font-display font-bold text-club-primary-deep">
                  {totalAppearances}
                </td>
                <td class="px-3 py-3 text-center font-display font-bold text-club-primary">
                  {totalGoals}
                </td>
                <td class="px-3 py-3 text-center text-club-muted">{totalYellow}</td>
                <td class="px-3 py-3 text-center text-club-muted">{totalRed}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    )}

    {/* Dodatne info */}
    {totalAppearances > 0 && (
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        {firstAppearance && (
          <div class="bg-club-light/30 border border-club-border rounded-lg px-4 py-3">
            <p class="text-xs uppercase tracking-wider text-club-muted font-display">
              Prvi nastup u sezoni
            </p>
            <p class="text-club-secondary font-medium mt-1">
              {formatShortDate(firstAppearance.iso)} ·
              {firstAppearance.home.id === OUR_CLUB_ID
                ? ` vs ${firstAppearance.away.name}`
                : ` vs ${firstAppearance.home.name}`}
            </p>
          </div>
        )}
        {totalGoals > 0 && (
          <div class="bg-club-light/30 border border-club-border rounded-lg px-4 py-3">
            <p class="text-xs uppercase tracking-wider text-club-muted font-display">
              Prosjek golova
            </p>
            <p class="text-club-secondary font-medium mt-1">
              {(totalGoals / totalAppearances).toLocaleString("hr-HR", { maximumFractionDigits: 2 })} po utakmici · zabio
              na {matchesWithGoals} {nastupLabel(matchesWithGoals)}
            </p>
          </div>
        )}
      </div>
    )}
  </section>

  {/* Lista utakmica */}
  <section class="container-narrow mb-20">
    <h2 class="text-xl font-display font-bold uppercase tracking-wider text-club-primary-deep mb-4">
      Utakmice ({totalAppearances})
    </h2>

    {totalAppearances === 0 ? (
      <p class="text-club-muted text-sm py-8 text-center bg-club-light/30 rounded-lg">
        Nema zabilježenih nastupa u tekućoj sezoni.
      </p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {appearances.map((a) => (
          <ResultCard
            match={{ ...a.match, isHome: a.ourSide === "home" }}
            label={competitionShort(a.match as unknown as UnifiedMatch)}
            date={shortDate(a.match.date)}
            note={playerNote(a)}
            noteIcon=""
            href={url(`/utakmica/${a.match.id}`)}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
