---
/**
 * Tanka traka sljedeće utakmice početnika (U-11) ispod kartice seniora.
 *
 * Namjerno samo raspored — kad, gdje, protiv koga. Rezultati, forma i
 * ljestvica djece ostaju na /mladje-kategorije; na naslovnici ih ne ističemo.
 */
import TeamCrest from "./TeamCrest.astro";
import MatchActions from "./MatchActions.astro";
import MatchWeather from "./MatchWeather.astro";
import { url } from "../lib/url";
import type { UnifiedMatch } from "../lib/matches";

interface Props {
  match: UnifiedMatch;
}

const { match } = Astro.props;

const when = new Date(match.iso).toLocaleDateString("hr-HR", {
  weekday: "short",
  day: "numeric",
  month: "numeric",
});
const short = (name: string) => name.replace(/^NK\s+/, "");
---

<article class="bg-white rounded-xl shadow border border-club-border px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
  <a
    href={url("/mladje-kategorije")}
    class="bg-club-accent text-club-primary-deep font-display font-bold uppercase text-xs tracking-wider px-2 py-1 rounded hover:brightness-95"
  >
    Početnici U-11
  </a>
  <span class="font-display font-bold text-club-primary-deep whitespace-nowrap">
    {when} · {match.time ?? "vrijeme naknadno"}
  </span>
  <span class="flex items-center gap-2 text-sm font-display font-bold uppercase min-w-0">
    <span class="w-5 h-5 flex-shrink-0">
      <TeamCrest team={match.home} size={20} class="w-full h-full" />
    </span>
    <span>{short(match.home.name)} – {short(match.away.name)}</span>
    <span class="w-5 h-5 flex-shrink-0">
      <TeamCrest team={match.away} size={20} class="w-full h-full" />
    </span>
  </span>
  <MatchWeather match={match} class="text-xs text-club-muted" />
  <span class="sm:ml-auto">
    <MatchActions match={match} variant="links" />
  </span>
</article>
