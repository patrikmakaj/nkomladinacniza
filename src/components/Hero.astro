---
/**
 * Plavo zaglavlje stranice.
 *
 * `lg` je veliki hero naslovnice (oznaka kluba, gumbi u slotu, kartice
 * utakmica flotiraju preko donjeg ruba). Podstranice koriste niski `md` —
 * samo naslov i podnaslov, da sadržaj počne na prvom ekranu.
 */
import { url } from "../lib/url";

interface Props {
  title: string;
  subtitle?: string;
  height?: "md" | "lg";
}

const { title, subtitle, height = "lg" } = Astro.props;
const big = height === "lg";
---

<section
  class={`relative overflow-hidden hero-bg ${
    // Na mobitelu niže, da kartice sljedeće utakmice stanu na prvi ekran.
    big ? "h-[420px] md:h-[560px]" : ""
  }`}
>
  <!-- Suptilan dijagonalni accent svijetlo plave -->
  <div
    class="absolute inset-0 opacity-15"
    style="background: repeating-linear-gradient(45deg, transparent, transparent 30px, rgba(255,255,255,0.4) 30px, rgba(255,255,255,0.4) 31px);"
  >
  </div>

  <!-- Veliki polu-prozirni grb kao watermark -->
  <div
    class={`absolute top-1/2 -translate-y-1/2 opacity-10 pointer-events-none ${
      big ? "-right-16" : "-right-12 md:right-0"
    }`}
  >
    <img
      src={url("/images/logo.svg")}
      alt=""
      width="500"
      height="500"
      class={big ? "w-[400px] md:w-[500px] h-auto" : "w-[200px] md:w-[300px] h-auto"}
    />
  </div>

  <!-- Akcent plavi sjaj u kutu -->
  <div
    class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full blur-3xl opacity-30"
    style="background: radial-gradient(circle, #4287f5 0%, transparent 70%);"
  >
  </div>

  <div
    class={`relative container-narrow flex flex-col justify-center ${
      big ? "h-full" : "py-10 md:py-14"
    }`}
  >
    <div class="max-w-3xl">
      {
        big && (
          <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 bg-club-accent text-club-primary-deep text-xs font-display uppercase tracking-widest font-bold rounded-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-club-primary-deep" />
            Nogometni klub
          </div>
        )
      }
      <h1
        class={`text-white font-bold leading-none drop-shadow-lg ${
          big ? "text-5xl md:text-7xl mb-4" : "text-4xl md:text-6xl mb-3"
        }`}
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class={`text-white/90 max-w-2xl ${big ? "text-lg md:text-xl" : "text-base md:text-lg"}`}>
            {subtitle}
          </p>
        )
      }
      <slot />
    </div>
  </div>
</section>
