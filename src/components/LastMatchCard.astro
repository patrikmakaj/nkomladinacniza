---
/**
 * Kartica zadnje odigrane utakmice: rezultat, strijelci i link na detalje.
 *
 * Strijelci dolaze iz `hns.matchDetails` (postoji samo za HNS utakmice koje
 * smo uspjeli dohvatiti), a za prijateljske iz ručno upisanih `scorers`.
 */
import hns from "../data/hns.json";
import TeamCrest from "./TeamCrest.astro";
import { url } from "../lib/url";
import { competitionShort, type UnifiedMatch } from "../lib/matches";
import { matchReport } from "../lib/match-posts";

interface Props {
  match: UnifiedMatch;
}

const { match } = Astro.props;

type GoalEvent = { type: string; minute: number | null; playerName: string | null };

const details = ((hns.matchDetails ?? {}) as Record<string, any>)[match.id];
const report = matchReport(match.id);
const hasDetail = !!details;

// HNS zna poslati "Luka, Glavaš" — zarez nije dio imena.
const cleanName = (name: string) => name.replace(/\s*,\s*/g, " ").trim();

/** "Luka Glavaš 2', 68'" — jedan zapis po igraču, redom prvog gola. */
function scorersFrom(events: GoalEvent[] = []): string[] {
  const byPlayer = new Map<string, { name: string; minutes: string[]; own: boolean }>();
  for (const e of events) {
    if (!["goal", "penalty", "own_goal"].includes(e.type) || !e.playerName) continue;
    const name = cleanName(e.playerName);
    const own = e.type === "own_goal";
    const key = `${name}|${own}`;
    const entry = byPlayer.get(key) ?? { name, minutes: [], own };
    if (e.minute != null) entry.minutes.push(`${e.minute}'${e.type === "penalty" ? " (11 m)" : ""}`);
    byPlayer.set(key, entry);
  }
  return [...byPlayer.values()].map(
    (g) => `${g.name}${g.minutes.length ? ` ${g.minutes.join(", ")}` : ""}${g.own ? " (autogol)" : ""}`,
  );
}

let homeScorers: string[] = [];
let awayScorers: string[] = [];
if (details?.headerEvents) {
  homeScorers = scorersFrom(details.headerEvents.home);
  awayScorers = scorersFrom(details.headerEvents.away);
} else if (match.scorers.length) {
  // Prijateljske: znamo samo naše strijelce i broj golova.
  const ours = match.scorers.map((s) => `${s.name}${s.goals > 1 ? ` (${s.goals})` : ""}`);
  if (match.isHome) homeScorers = ours;
  else awayScorers = ours;
}

const score = match.score!;
const sides = [
  { team: match.home, goals: score.home, scorers: homeScorers, won: score.home > score.away },
  { team: match.away, goals: score.away, scorers: awayScorers, won: score.away > score.home },
];

const outcome = {
  W: { label: "Pobjeda", cls: "bg-green-600" },
  D: { label: "Neriješeno", cls: "bg-yellow-500" },
  L: { label: "Poraz", cls: "bg-red-600" },
}[match.result ?? "D"];

const dateLabel = new Date(match.iso).toLocaleDateString("hr-HR", {
  weekday: "short",
  day: "numeric",
  month: "long",
});
---

<article class="bg-white rounded-lg shadow-xl border border-club-border overflow-hidden flex flex-col">
  <div class="bg-club-secondary text-white px-4 md:px-5 py-2.5 flex items-center justify-between gap-3">
    <span class="font-display uppercase tracking-wider text-sm font-bold">Zadnja utakmica</span>
    <span class="text-xs font-display uppercase tracking-widest opacity-80 text-right">
      {competitionShort(match)}
    </span>
  </div>

  <div class="p-4 md:p-5 space-y-3 flex-1">
    {
      sides.map((s) => (
        <div class="flex items-start gap-3">
          <span class="w-8 h-8 flex-shrink-0 flex items-center justify-center">
            <TeamCrest team={s.team} size={32} class="w-full h-full" />
          </span>
          <div class="flex-1 min-w-0 pt-1">
            <p class="font-display font-bold uppercase text-sm leading-tight">{s.team.name}</p>
            {s.scorers.length > 0 && (
              <p class="text-xs text-club-muted mt-1 leading-snug">{s.scorers.join(" · ")}</p>
            )}
          </div>
          <span
            class={`font-display font-bold text-3xl leading-none tabular-nums ${
              s.won ? "text-club-primary-deep" : "text-club-muted"
            }`}
          >
            {s.goals}
          </span>
        </div>
      ))
    }
    {
      report && (
        <p class="text-sm text-club-secondary/80 italic leading-snug line-clamp-3 border-l-2 border-club-accent pl-3">
          {report.message}
        </p>
      )
    }
  </div>

  <div class="border-t border-club-border px-4 md:px-5 py-2.5 flex items-center justify-between gap-3 text-xs">
    <span class="flex items-center gap-2 text-club-muted">
      <span class={`${outcome.cls} text-white font-display font-bold uppercase tracking-wider px-2 py-0.5 rounded`}>
        {outcome.label}
      </span>
      {dateLabel}
    </span>
    {
      hasDetail && (
        <a
          href={url(`/utakmica/${match.id}`)}
          class="font-display uppercase tracking-wider text-club-primary hover:underline flex-shrink-0"
        >
          {report ? "Izvještaj →" : "Detalji →"}
        </a>
      )
    }
  </div>
</article>
