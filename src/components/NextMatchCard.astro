---
/**
 * Kartica sljedeće seniorske utakmice: lijevo utakmica (grbovi, vrijeme,
 * mjesto, prognoza, gumbi), desno usporedba obje ekipe iz ljestvice kao mala
 * tablica (plasman, bodovi, golovi po utakmici) i forma zadnjih 5.
 *
 * Usporedba se prikazuje samo ako su obje ekipe u ljestvici i odigrale su
 * barem jedno kolo — za kup protiv kluba iz druge lige, prijateljsku ili
 * početak sezone nema se što usporediti, pa kartica ostaje samo najava
 * (lijevi dio na punoj širini).
 */
import TeamCrest from "./TeamCrest.astro";
import FormStrip from "./FormStrip.astro";
import MatchActions from "./MatchActions.astro";
import MatchWeather from "./MatchWeather.astro";
import { venueFor } from "../lib/venue";
import { competitionShort, type LeagueRow, type UnifiedMatch } from "../lib/matches";

interface Props {
  match: UnifiedMatch | null;
  /** Ljestvica iz koje se čita usporedba; bez nje je kartica samo najava. */
  table?: LeagueRow[];
  /** Stranica najave za gumb "Podijeli", npr. "/najava/123". */
  sharePath?: string;
  /** Naslov u zaglavlju kartice. */
  heading?: string;
}

const { match, table = [], sharePath, heading = "Sljedeća utakmica" } = Astro.props;

let dateLabel = "";
let dayLabel = "";
let timeLabel = "";
if (match) {
  const dateObj = new Date(match.iso);
  dateLabel = dateObj.toLocaleDateString("hr-HR", { day: "numeric", month: "long" });
  dayLabel = dateObj.toLocaleDateString("hr-HR", { weekday: "long" });
  timeLabel = match.time || "uskoro";
}

// Za gostovanje: igralište ako ga znamo iz ranijih utakmica, inače domaćin.
const venueInfo = match ? venueFor(match) : null;
const venue = match?.isHome
  ? "Grbavica, Niza"
  : `Gosti · ${venueInfo?.exact ? venueInfo.label : (match?.venue ?? match?.home?.name ?? "")}`;

// ── Usporedba iz ljestvice ──────────────────────────────────────────────
const rowOf = (id: number | null) =>
  id == null ? undefined : table.find((r) => r.club.id === id);
const homeRow = match ? rowOf(match.home.id) : undefined;
const awayRow = match ? rowOf(match.away.id) : undefined;

type Side = "home" | "away" | null;

/** Koja je strana bolja; `lowerIsBetter` za plasman i primljene golove. */
function better(h: number | null, a: number | null, lowerIsBetter = false): Side {
  if (h == null || a == null || h === a) return null;
  return h < a === lowerIsBetter ? "home" : "away";
}

/** Prosjek po utakmici, zaokružen na jednu decimalu (uspoređuje se ono što piše). */
function perGame(goals: number | null, played: number | null): number | null {
  if (goals == null || !played) return null;
  return Math.round((goals / played) * 10) / 10;
}

const decimal = (n: number | null) =>
  n == null
    ? "—"
    : n.toLocaleString("hr-HR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });

type CompareRow = { label: string; home: string; away: string; better: Side };

const rows: CompareRow[] = [];
let form: { home: string[]; away: string[] } | null = null;
if (homeRow?.played && awayRow?.played) {
  rows.push({
    label: "Plasman",
    home: homeRow.position != null ? `${homeRow.position}.` : "—",
    away: awayRow.position != null ? `${awayRow.position}.` : "—",
    better: better(homeRow.position, awayRow.position, true),
  });
  rows.push({
    label: "Bodovi",
    home: String(homeRow.points ?? "—"),
    away: String(awayRow.points ?? "—"),
    better: better(homeRow.points, awayRow.points),
  });
  if (homeRow.form.length || awayRow.form.length) {
    form = { home: homeRow.form, away: awayRow.form };
  }
  const hScored = perGame(homeRow.gf, homeRow.played);
  const aScored = perGame(awayRow.gf, awayRow.played);
  const hConceded = perGame(homeRow.ga, homeRow.played);
  const aConceded = perGame(awayRow.ga, awayRow.played);
  rows.push({
    label: "Golova / ut.",
    home: decimal(hScored),
    away: decimal(aScored),
    better: better(hScored, aScored),
  });
  rows.push({
    label: "Primljeno / ut.",
    home: decimal(hConceded),
    away: decimal(aConceded),
    better: better(hConceded, aConceded, true),
  });
}

function valueClass(row: { better: Side }, side: "home" | "away"): string {
  if (row.better === null) return "text-club-secondary";
  return row.better === side ? "text-club-primary-deep" : "text-club-muted font-normal";
}
---

{
  match ? (
    <article class="bg-white shadow-xl rounded-xl overflow-hidden border border-club-border">
      <div class="bg-gradient-to-r from-club-primary-deep to-club-primary text-white px-5 py-3 flex items-center justify-between gap-3">
        <span class="font-display uppercase tracking-wider text-sm font-bold">{heading}</span>
        <span class="text-xs font-display uppercase tracking-widest opacity-90 text-right">
          {competitionShort(match)}
        </span>
      </div>

      <div class={rows.length > 0 ? "grid md:grid-cols-[1.1fr_1fr]" : ""}>
        {/* Utakmica */}
        <div class="p-5 md:p-6 flex flex-col justify-center">
          <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
            {[match.home, null, match.away].map((team) =>
              team ? (
                <div class="flex flex-col items-center text-center gap-2">
                  <span class="w-16 h-16 flex items-center justify-center">
                    <TeamCrest team={team} size={64} class="w-full h-full" />
                  </span>
                  <p class="font-display font-bold uppercase text-sm leading-tight">{team.name}</p>
                </div>
              ) : (
                <div class="text-center px-2">
                  <p class="text-[11px] uppercase tracking-widest text-club-muted">{dayLabel}</p>
                  <p class="font-display font-bold text-4xl text-club-primary-deep leading-none my-1">
                    {timeLabel}
                  </p>
                  <p class="text-xs text-club-muted">{dateLabel}</p>
                </div>
              ),
            )}
          </div>

          <p class="mt-5 flex items-center justify-center gap-1.5 text-sm text-club-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{venue}</span>
          </p>
          <MatchWeather match={match} class="mt-1 text-center text-sm text-club-secondary" />
          <div class="mt-4">
            <MatchActions match={match} sharePath={sharePath} />
          </div>
        </div>

        {/* Usporedba */}
        {rows.length > 0 && (
          <div class="bg-club-light-2 border-t md:border-t-0 md:border-l border-club-border p-5 md:p-6">
            <p class="text-[11px] font-display uppercase tracking-widest text-club-muted mb-2">
              Usporedba u ligi
            </p>
            <table class="w-full text-sm">
              <thead>
                <tr>
                  <th class="w-2/5"><span class="sr-only">Pokazatelj</span></th>
                  {[match.home, match.away].map((team) => (
                    <th class="pb-2 font-normal">
                      <span class="inline-flex w-6 h-6 align-middle" title={team.name}>
                        <TeamCrest team={team} size={24} class="w-full h-full" />
                      </span>
                      <span class="sr-only">{team.name}</span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-club-border">
                {rows.map((row) => (
                  <tr>
                    <td class="py-2 text-xs uppercase tracking-wider text-club-muted">{row.label}</td>
                    <td class={`py-2 text-center font-display font-bold text-base ${valueClass(row, "home")}`}>
                      {row.home}
                    </td>
                    <td class={`py-2 text-center font-display font-bold text-base ${valueClass(row, "away")}`}>
                      {row.away}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {form && (
              <div class="mt-3 pt-3 border-t border-club-border">
                <p class="text-xs uppercase tracking-wider text-club-muted mb-2">
                  Forma <span class="normal-case tracking-normal">· najnovija desno</span>
                </p>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  {[
                    { team: match.home, form: form.home },
                    { team: match.away, form: form.away },
                  ].map((f) => (
                    <span class="inline-flex items-center gap-1.5">
                      <span class="w-5 h-5 inline-flex">
                        <TeamCrest team={f.team} size={20} class="w-full h-full" />
                      </span>
                      <FormStrip form={f.form} />
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </article>
  ) : (
    <article class="bg-white shadow-xl rounded-xl overflow-hidden border border-club-border p-8 text-center">
      <p class="text-club-muted">Nema rasporeda za sljedeću utakmicu.</p>
    </article>
  )
}
