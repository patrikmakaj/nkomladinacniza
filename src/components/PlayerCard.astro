---
import { golLabel, nastupLabel } from "../lib/croatian";
import { photoSrc } from "../lib/images";
import { url } from "../lib/url";

interface Props {
  personId?: number | null;
  number: number | null;
  name: string;
  position: string | null;
  positionGroup: "GK" | "FIELD";
  photo?: string | null;
  appearances?: number;
  goals?: number;
}

const {
  personId,
  number,
  name,
  position,
  positionGroup,
  photo,
  appearances = 0,
  goals = 0,
} = Astro.props;

const profileHref = personId ? url(`/igrac/${personId}`) : null;

// HNS razlikuje samo "Vratar" i "Igrač" — na /momcad su to naslovi skupina,
// pa kartica ne ponavlja oznaku. Ispod imena pozicija ide samo ako HNS ikad
// pošalje nešto preciznije.
const detail = position && !/^(igrač|vratar)$/i.test(position.trim()) ? position : null;

// Inicijali za fallback ako nema slike
const initials = name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<article
  class="group relative bg-white border border-club-border rounded-xl overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
  data-position={positionGroup}
>
  {profileHref && (
    <a
      href={profileHref}
      class="absolute inset-0 z-10"
      aria-label={`Profil — ${name}`}
    />
  )}
  <div class="aspect-[4/5] bg-gradient-to-br from-club-primary-deep to-club-primary-dark flex items-center justify-center relative overflow-hidden">
    {photo ? (
      <img
        src={photoSrc(photo)}
        alt={name}
        class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-300"
        loading="lazy"
      />
    ) : (
      <span class="font-display text-6xl text-white/30 font-bold">{initials}</span>
    )}
    {/* Ime preko donjeg ruba fotke, broj diskretno u kutu */}
    <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-club-primary-deep/95 via-club-primary-deep/50 to-transparent pointer-events-none"></div>
    {number != null && (
      <span class="absolute top-2 left-2 min-w-7 h-7 px-1.5 rounded-md bg-club-primary-deep/80 backdrop-blur-sm text-white font-display font-bold text-sm flex items-center justify-center">
        {number}
      </span>
    )}
    <p class="absolute inset-x-0 bottom-0 px-3 pb-2.5 font-display font-bold uppercase text-white text-[15px] leading-tight drop-shadow" title={name}>
      {name}
    </p>
  </div>
  <div class="px-3 py-2.5 flex items-center gap-3 text-xs min-h-10">
    {detail && <span class="text-club-muted">{detail}</span>}
    {appearances > 0 ? (
      <>
        <span class="flex items-center gap-1">
          <span class="font-display font-bold text-club-primary-deep">{appearances}</span>
          <span class="text-club-muted">{nastupLabel(appearances)}</span>
        </span>
        {goals > 0 && (
          <span class="flex items-center gap-1">
            <span class="font-display font-bold text-club-primary">{goals}</span>
            <span class="text-club-muted">{golLabel(goals)}</span>
          </span>
        )}
      </>
    ) : (
      <span class="text-club-muted">Bez nastupa</span>
    )}
  </div>
</article>
