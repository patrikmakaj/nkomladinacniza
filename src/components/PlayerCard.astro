---
import { golLabel, nastupLabel } from "../lib/croatian";
import { photoSrc } from "../lib/images";
import { url } from "../lib/url";

interface Props {
  personId?: number | null;
  number: number | null;
  name: string;
  position: string | null;
  positionGroup: "GK" | "FIELD";
  photo?: string | null;
  appearances?: number;
  goals?: number;
}

const {
  personId,
  number,
  name,
  position,
  positionGroup,
  photo,
  appearances = 0,
  goals = 0,
} = Astro.props;

const profileHref = personId ? url(`/igrac/${personId}`) : null;

// HNS razlikuje samo "Vratar" i "Igrač". "Igrač" bi pisalo na skoro svakoj
// kartici i ne bi ništa govorilo, pa se ističe samo vratar. Ispod imena
// pozicija ide samo ako HNS ikad pošalje nešto preciznije.
const isKeeper = positionGroup === "GK";
const detail = position && !/^(igrač|vratar)$/i.test(position.trim()) ? position : null;

// Inicijali za fallback ako nema slike
const initials = name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<article
  class="group relative bg-white border border-club-border rounded-lg overflow-hidden hover:shadow-xl hover:border-club-primary transition-all duration-200"
  data-position={positionGroup}
>
  {profileHref && (
    <a
      href={profileHref}
      class="absolute inset-0 z-10"
      aria-label={`Profil — ${name}`}
    />
  )}
  <div class="aspect-[3/4] bg-gradient-to-br from-club-primary-deep to-club-primary/40 flex items-center justify-center relative overflow-hidden">
    {photo ? (
      <img
        src={photoSrc(photo)}
        alt={name}
        class="w-full h-full object-cover object-top"
        loading="lazy"
      />
    ) : (
      <span class="font-display text-6xl text-white/30 font-bold">{initials}</span>
    )}
    {number != null && (
      <div class="absolute top-2 left-2 bg-white text-club-secondary font-display font-bold text-lg w-10 h-10 rounded flex items-center justify-center shadow-md">
        {number}
      </div>
    )}
    {isKeeper && (
      <div class="absolute top-2 right-2 bg-club-accent text-club-primary-deep text-xs font-display font-bold uppercase tracking-wider px-2 py-1 rounded shadow">
        Vratar
      </div>
    )}
  </div>
  <div class="p-3">
    <p class="font-display font-bold uppercase text-sm leading-tight truncate" title={name}>
      {name}
    </p>
    {detail && <p class="text-xs text-club-muted mt-0.5">{detail}</p>}
    {(appearances > 0 || goals > 0) && (
      <div class="flex items-center gap-3 mt-2 pt-2 border-t border-club-border text-xs">
        <span class="flex items-center gap-1">
          <span class="font-display font-bold text-club-primary-deep">{appearances}</span>
          <span class="text-club-muted">{nastupLabel(appearances)}</span>
        </span>
        {goals > 0 && (
          <span class="flex items-center gap-1">
            <span class="font-display font-bold text-club-primary">{goals}</span>
            <span class="text-club-muted">{golLabel(goals)}</span>
          </span>
        )}
      </div>
    )}
  </div>
</article>
