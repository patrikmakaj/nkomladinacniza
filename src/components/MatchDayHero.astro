---
/**
 * Match-day hero banner — prikazuje se samo na dan utakmice.
 *
 * Naslovnica renderira po jedan banner za sljedeću utakmicu svake ekipe
 * (seniori, U-11) kojoj znamo vrijeme početka, a koji je vidljiv odlučuje
 * skripta u pregledniku: prvi čija je utakmica danas (Europe/Zagreb) i nije
 * završila prije više od ~2.5h. Kad obje ekipe igraju isti dan, banner tako
 * ujutro odbrojava do U-11, a nakon njihove utakmice prijeđe na seniore.
 *
 * Na datum builda se ne smijemo osloniti: stranica je statička i ne gradi se
 * svaki dan (cron deploya samo kad se podaci promijene, plus jednom dnevno
 * iza ponoći). Server ipak odmah prikaže stanje za dan builda (`visible`),
 * da se u normalnom slučaju ništa ne pomiče pri učitavanju.
 *
 * Vrijeme početka nosi zagrebački offset (`+02:00` / `+01:00`), pa je
 * odbrojavanje točno i posjetiteljima izvan Hrvatske.
 */
import Logo from "./Logo.astro";
import { crestSrc } from "../lib/images";
import { kickoffIso } from "../lib/matches";

interface Props {
  match: {
    date: string;
    iso: string;
    time: string | null;
    isHome: boolean;
    home: { id: number | null; name: string; logo: string | null };
    away: { id: number | null; name: string; logo: string | null };
  };
  /** Ekipa i natjecanje, npr. "Seniori · 2. ŽNL · 6. kolo". */
  label: string;
  /** Je li ovo banner za dan builda — samo za početno stanje. */
  visible: boolean;
  /** Redak o kasnijoj utakmici istog dana, npr. "Danas još: Seniori u 18:00, …". */
  alsoToday?: string | null;
}

const { match, label, visible, alsoToday } = Astro.props;

const kickoff = kickoffIso(match);

// Vrijeme prikazujemo direktno iz ISO stringa (HH:MM dio) — izbjegava TZ trikove
const kickoffTime = match.iso.slice(11, 16);

const venue = match.isHome
  ? "Grbavica · Niza"
  : `Gosti · ${match.home.name}`;

// Skratimo dugačke nazive klubova (npr. "NK Omladinac Niza" → "Omladinac")
function shortName(name: string): string {
  return name.replace(/^NK\s+/, "");
}
---

<aside
  data-match-day-hero
  data-kickoff-iso={kickoff}
  data-match-date={match.date}
  style={visible ? undefined : "display: none"}
  class="match-day-hero relative bg-gradient-to-br from-club-primary-deep via-club-secondary to-club-primary text-white overflow-hidden border-b-4 border-club-accent shadow-2xl"
>
  {/* Decorativni grb watermark */}
  <div class="absolute -right-20 top-1/2 -translate-y-1/2 opacity-10 pointer-events-none">
    <Logo size={400} />
  </div>

  {/* Akcent svjetlo */}
  <div
    class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full blur-3xl opacity-25 pointer-events-none"
    style="background: radial-gradient(circle, #d4b659 0%, transparent 70%);"
  >
  </div>

  <div class="container-narrow relative py-8 md:py-12">
    {/* Top — DANAS badge + ekipa i natjecanje */}
    <div class="flex justify-center items-center gap-3 mb-6 flex-wrap">
      <span
        data-hero="badge"
        class="inline-flex items-center gap-2 px-3 py-1 bg-red-600 rounded-full text-xs font-display uppercase tracking-widest font-bold shadow-lg"
      >
        <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
        <span data-hero="status">Danas</span>
      </span>
      <span class="text-xs uppercase tracking-wider text-white/70">
        {label}
      </span>
    </div>

    {/* Domaći vs Gosti */}
    <div class="grid grid-cols-3 items-center gap-2 md:gap-6 mb-8">
      {/* Domaći */}
      <div class="text-center">
        <div class="w-16 h-16 md:w-24 md:h-24 mx-auto mb-2 md:mb-3 flex items-center justify-center">
          {match.home.id === 134 ? (
            <Logo size={96} />
          ) : match.home.logo ? (
            <img
              src={crestSrc(match.home.logo)}
              alt={`${match.home.name} grb`}
              width="96"
              height="96"
              class="object-contain w-full h-full"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full rounded-full bg-white/10 flex items-center justify-center text-white/40">?</div>
          )}
        </div>
        <p class="font-display font-bold uppercase text-sm md:text-lg leading-tight">
          {shortName(match.home.name)}
        </p>
      </div>

      {/* Vrijeme */}
      <div class="text-center">
        <p class="text-xs uppercase tracking-widest text-club-accent font-display font-bold mb-1">
          Prvi zvižduk
        </p>
        <p class="font-display font-bold text-4xl md:text-6xl text-club-accent leading-none">
          {kickoffTime}
        </p>
      </div>

      {/* Gosti */}
      <div class="text-center">
        <div class="w-16 h-16 md:w-24 md:h-24 mx-auto mb-2 md:mb-3 flex items-center justify-center">
          {match.away.id === 134 ? (
            <Logo size={96} />
          ) : match.away.logo ? (
            <img
              src={crestSrc(match.away.logo)}
              alt={`${match.away.name} grb`}
              width="96"
              height="96"
              class="object-contain w-full h-full"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full rounded-full bg-white/10 flex items-center justify-center text-white/40">?</div>
          )}
        </div>
        <p class="font-display font-bold uppercase text-sm md:text-lg leading-tight">
          {shortName(match.away.name)}
        </p>
      </div>
    </div>

    {/* Countdown ili "U tijeku" */}
    <div class="text-center">
      <p
        data-hero="label"
        class="text-xs md:text-sm text-white/80 uppercase tracking-widest mb-3"
      >
        Do prvog zvižduka
      </p>
      <div
        data-hero="countdown"
        class="inline-flex items-end gap-3 md:gap-6 font-display font-bold"
      >
        <div class="text-center">
          <span data-hero="h" class="block text-3xl md:text-5xl tabular-nums leading-none">--</span>
          <span class="text-[10px] md:text-xs uppercase tracking-widest text-white/60 mt-1 inline-block">sati</span>
        </div>
        <span class="text-3xl md:text-5xl text-white/40 leading-none">:</span>
        <div class="text-center">
          <span data-hero="m" class="block text-3xl md:text-5xl tabular-nums leading-none">--</span>
          <span class="text-[10px] md:text-xs uppercase tracking-widest text-white/60 mt-1 inline-block">min</span>
        </div>
        <span class="text-3xl md:text-5xl text-white/40 leading-none">:</span>
        <div class="text-center">
          <span data-hero="s" class="block text-3xl md:text-5xl tabular-nums leading-none">--</span>
          <span class="text-[10px] md:text-xs uppercase tracking-widest text-white/60 mt-1 inline-block">sek</span>
        </div>
      </div>
    </div>

    {/* Venue */}
    <p class="text-center text-sm text-white/80 mt-6 flex items-center justify-center gap-1.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span>{venue}</span>
    </p>

    {
      alsoToday && (
        <p class="text-center text-xs md:text-sm text-club-accent font-display uppercase tracking-wider mt-4">
          {alsoToday}
        </p>
      )
    }
  </div>
</aside>

<script>
  const HIDE_AFTER_MS = 2.5 * 60 * 60 * 1000; // 2.5h nakon kickoffa
  const HALFTIME_MS = 45 * 60 * 1000;
  const FULLTIME_MS = 105 * 60 * 1000; // 90 + 15 pauza, gruba procjena

  const zagrebDate = new Intl.DateTimeFormat("en-US", {
    timeZone: "Europe/Zagreb",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });

  let timer: number | undefined;

  function stop() {
    if (timer !== undefined) clearInterval(timer);
    timer = undefined;
  }

  /** Današnji datum ("YYYY-MM-DD") u Europe/Zagreb, neovisno o zoni posjetitelja. */
  function todayInZagreb(): string {
    const parts = zagrebDate.formatToParts(new Date());
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? "";
    return `${get("year")}-${get("month")}-${get("day")}`;
  }

  function pad(n: number): string {
    return String(n).padStart(2, "0");
  }

  const kickoffOf = (banner: HTMLElement) =>
    new Date(banner.dataset.kickoffIso ?? "").getTime();

  /** Banner koji se sad prikazuje: današnja utakmica koja nije davno završila. */
  function pickActive(banners: HTMLElement[]): HTMLElement | null {
    const today = todayInZagreb();
    const now = Date.now();
    return (
      banners.find(
        (b) => b.dataset.matchDate === today && now < kickoffOf(b) + HIDE_AFTER_MS,
      ) ?? null
    );
  }

  function render(banner: HTMLElement) {
    const el = (name: string) => banner.querySelector<HTMLElement>(`[data-hero="${name}"]`);
    const kickoffMs = kickoffOf(banner);
    const now = Date.now();
    const diff = kickoffMs - now;

    if (diff > 0) {
      // PRE-MATCH: countdown
      const totalSec = Math.floor(diff / 1000);
      const h = el("h");
      const m = el("m");
      const s = el("s");
      if (h) h.textContent = pad(Math.floor(totalSec / 3600));
      if (m) m.textContent = pad(Math.floor((totalSec % 3600) / 60));
      if (s) s.textContent = pad(totalSec % 60);
      return;
    }

    // POST-KICKOFF: utakmica u tijeku
    const elapsedMs = now - kickoffMs;
    const elapsedMin = Math.floor(elapsedMs / 60000);
    let phase = "1. poluvrijeme";
    if (elapsedMs > FULLTIME_MS) phase = "Završeno";
    else if (elapsedMs > 60 * 60 * 1000) phase = "2. poluvrijeme";
    else if (elapsedMs > HALFTIME_MS) phase = "Pauza";

    const countdown = el("countdown");
    if (countdown) {
      countdown.innerHTML = `
        <div class="text-center">
          <span class="block text-2xl md:text-4xl font-display font-bold leading-tight text-club-accent">${phase}</span>
          <span class="text-xs md:text-sm uppercase tracking-widest text-white/60 mt-1 inline-block">${elapsedMin} min od početka</span>
        </div>
      `;
    }
    const label = el("label");
    const status = el("status");
    const badge = el("badge");
    if (label) label.textContent = "Status utakmice";
    if (status) status.textContent = "Uživo";
    if (badge) {
      badge.classList.remove("bg-red-600");
      badge.classList.add("bg-green-600");
    }
  }

  function setup() {
    stop();
    const banners = [...document.querySelectorAll<HTMLElement>("[data-match-day-hero]")]
      .filter((b) => !Number.isNaN(kickoffOf(b)))
      .sort((a, b) => kickoffOf(a) - kickoffOf(b));
    if (!banners.length) return;

    function tick() {
      const active = pickActive(banners);
      for (const b of banners) b.style.display = b === active ? "" : "none";
      if (active) render(active);
      else stop();
    }

    tick();
    if (pickActive(banners)) timer = window.setInterval(tick, 1000);
  }

  // View Transitions: skripta se izvrši samo jednom, pa se odbrojavanje mora
  // ponovo vezati na svaki dolazak na naslovnicu, a interval ugasiti pri odlasku.
  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", stop);
</script>
