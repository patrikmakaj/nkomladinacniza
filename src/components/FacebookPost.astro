---
import { url } from "../lib/url";
import { linkify, formatPostDate, formatRelative } from "../lib/facebook";

/**
 * Slika uz objavu. Stariji facebook.json ima obične stringove — dok ga CI ne
 * pregazi novim formatom, `normalizeImage` ih izjednači.
 */
type PostImage = {
  src: string;
  thumb?: string | null;
  width?: number | null;
  height?: number | null;
};

interface Post {
  id: string;
  message: string;
  createdAt: string;
  permalink: string | null;
  images: (string | PostImage)[];
}

const normalizeImage = (img: string | PostImage): PostImage =>
  typeof img === "string" ? { src: img } : img;

interface Props {
  post: Post;
  /** Ako true, tekst je collapsed iznad ~5 linija s "Pročitaj više" */
  collapsible?: boolean;
}

const { post, collapsible = false } = Astro.props;

const messageHtml = linkify(post.message);
const dateAbsolute = formatPostDate(post.createdAt);
const dateRelative = formatRelative(post.createdAt);

// Slike idu u okvir 4:5 — u tom su formatu gotovo sve objave (plakati
// utakmica), pa se kartice u mreži poravnaju i plakat ostane cijeli.
// Do 4 slike; ostatak je "+N" na zadnjoj, sve su na Facebooku.
const images = post.images.map(normalizeImage);
const shown = images.slice(0, 4);
const extra = images.length - shown.length;
const imageGridClass =
  shown.length === 1 ? "" : shown.length === 2 ? "grid-cols-2" : "grid-cols-2 grid-rows-2";
---

{/* id: kartice na naslovnici linkaju ravno na objavu (/novosti#objava-…) */}
<article
  id={`objava-${post.id}`}
  class="bg-white border border-club-border rounded-lg overflow-hidden hover:shadow-md transition-shadow scroll-mt-24 flex flex-col"
>
  {/* Header - datum + permalink */}
  <header class="flex items-center justify-between px-5 py-3 border-b border-club-border bg-club-light-2">
    <div class="flex items-center gap-2 text-sm">
      <svg class="w-4 h-4 text-club-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/>
      </svg>
      <time datetime={post.createdAt} title={dateAbsolute} class="text-club-muted">
        {dateRelative}
      </time>
    </div>
    {
      post.permalink && (
        <a
          href={post.permalink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-display uppercase tracking-wider text-club-primary hover:underline"
        >
          Otvori na FB →
        </a>
      )
    }
  </header>

  {/* Slike */}
  {
    shown.length > 0 && (
      <div class={`grid ${imageGridClass} gap-1 aspect-[4/5] bg-club-light-2`}>
        {shown.map((img, idx) => (
          <a
            href={url(img.src)}
            target="_blank"
            rel="noopener noreferrer"
            class={`relative block overflow-hidden min-h-0 ${shown.length === 3 && idx === 0 ? "row-span-2" : ""}`}
          >
            {/* Feed prikazuje thumb; klik otvara original */}
            <img
              src={url(img.thumb || img.src)}
              alt="Slika iz Facebook objave"
              width={img.width ?? undefined}
              height={img.height ?? undefined}
              loading="lazy"
              class="w-full h-full object-cover hover:opacity-95 transition-opacity"
            />
            {extra > 0 && idx === shown.length - 1 && (
              <span class="absolute inset-0 bg-black/50 text-white font-display font-bold text-3xl flex items-center justify-center">
                +{extra}
              </span>
            )}
          </a>
        ))}
      </div>
    )
  }

  {/* Tekst posta */}
  {
    post.message && (
      <div class="px-5 py-4">
        {collapsible ? (
          <details class="fb-post-collapsible">
            <summary class="cursor-pointer list-none">
              <div
                class="text-club-secondary leading-relaxed line-clamp-5"
                set:html={messageHtml}
              />
              <span class="inline-block mt-2 text-sm font-display uppercase tracking-wider text-club-primary hover:underline">
                Pročitaj više →
              </span>
            </summary>
            <div
              class="text-club-secondary leading-relaxed mt-2"
              set:html={messageHtml}
            />
          </details>
        ) : (
          <div class="text-club-secondary leading-relaxed" set:html={messageHtml} />
        )}
      </div>
    )
  }
</article>

<style>
  /* Collapsible: kad je `details` open, sakrij summary preview, prikaži pun tekst */
  details.fb-post-collapsible[open] > summary {
    display: none;
  }
  /* Inicijalno stanje: sakrij ekspandirani div, summary preview je vidljiv */
  details.fb-post-collapsible:not([open]) > div {
    display: none;
  }

  /* line-clamp-5 (Tailwind v4 ima utility, ali za sigurnost) */
  .line-clamp-5 {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
