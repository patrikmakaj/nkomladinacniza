---
/**
 * Sezona u brojkama — plasman, bodovi, gol-razlika i najbolji strijelac
 * seniora. Plasman i bodovi iz ljestvice lige; strijelci su zbroj svih
 * seniorskih natjecanja (`hns.stats`, vidi mergeStats u scraperu).
 *
 * Prije prvog kola nema se što pokazati, pa se blok ne renderira.
 */
import hns from "../data/hns.json";
import { url } from "../lib/url";
import { golLabel } from "../lib/croatian";
import { competitionsFor, type LeagueRow } from "../lib/matches";
import { seasons } from "../lib/seasons";

type Scorer = { personId: number | null; name: string; goals?: number | null };

interface Props {
  /** Ljestvica lige; bez nje tekuća seniorska. */
  table?: LeagueRow[];
  /** Strijelci (najbolji prvi); bez njih tekući. */
  scorers?: Scorer[];
  /** Naslov bloka; bez njega "Sezona 26/27 u brojkama". */
  heading?: string;
  /** Koja natjecanja zbrajaju strijelci ("liga i kup"). */
  scope?: string;
  /** Bez vanjskog razmaka i linka na arhivu — kad je blok dio stranice sezone. */
  embedded?: boolean;
}

const props = Astro.props;
const table = props.table ?? ((hns.table ?? []) as LeagueRow[]);
const us = table.find((r) => r.isUs);

const season = hns.competition?.name?.match(/\d{2}\/\d{2}/)?.[0] ?? null;
const heading = props.heading ?? `Sezona${season ? ` ${season}` : ""} u brojkama`;

// Strijelci: svi s najviše golova (zna biti izjednačeno).
const scorers = ((props.scorers ?? hns.stats?.topScorers ?? []) as Scorer[]).filter(
  (s) => (s.goals ?? 0) > 0,
);
const topGoals = scorers[0]?.goals ?? 0;
const leaders = scorers.filter((s) => s.goals === topGoals);
// Profil postoji samo za igrače iz tekućeg rostera.
const rosterIds = new Set(((hns.players ?? []) as { id: number | null }[]).map((p) => p.id));
const leader = leaders[0];
const leaderHref =
  leader?.personId != null && rosterIds.has(leader.personId) ? url(`/igrac/${leader.personId}`) : null;

const gd = us && us.gf != null && us.ga != null ? us.gf - us.ga : null;
// Pravi minus (−), ne crtica; plus za pozitivnu razliku.
const gdLabel = gd == null ? "—" : gd > 0 ? `+${gd}` : gd < 0 ? `−${Math.abs(gd)}` : "0";

const show = !!us?.played || topGoals > 0;

// Strijelci su zbroj seniorskih natjecanja — napiši kojih.
const types = new Set(competitionsFor("Seniors").map((c) => c.type));
const scope =
  props.scope ??
  (types.has("league") && types.has("cup") ? "liga i kup" : types.has("cup") ? "kup" : "liga");
---

{
  show && (
    <section class={props.embedded ? "" : "container-narrow mt-16"}>
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 class="text-2xl">{heading}</h2>
        {!props.embedded && seasons.length > 0 && (
          <a
            href={url("/povijest#sezone")}
            class="text-sm font-display uppercase tracking-wider text-club-primary hover:underline whitespace-nowrap"
          >
            Prošle sezone →
          </a>
        )}
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {us && (
          <>
            <div class="bg-white border border-club-border rounded-lg p-4 md:p-5">
              <p class="text-[11px] font-display uppercase tracking-widest text-club-muted">Plasman</p>
              <p class="font-display font-bold text-4xl text-club-primary-deep mt-1 leading-none">
                {us.position ?? "—"}.
                <span class="text-base text-club-muted font-medium"> / {table.length}</span>
              </p>
              <p class="text-xs text-club-muted mt-2">u ligi</p>
            </div>
            <div class="bg-white border border-club-border rounded-lg p-4 md:p-5">
              <p class="text-[11px] font-display uppercase tracking-widest text-club-muted">Bodovi</p>
              <p class="font-display font-bold text-4xl text-club-primary-deep mt-1 leading-none">
                {us.points ?? "—"}
              </p>
              <p class="text-xs text-club-muted mt-2" title="pobjede · neriješeno · izgubljeno">
                {us.wins ?? 0} P · {us.draws ?? 0} N · {us.losses ?? 0} I
              </p>
            </div>
            <div class="bg-white border border-club-border rounded-lg p-4 md:p-5">
              <p class="text-[11px] font-display uppercase tracking-widest text-club-muted">Gol-razlika</p>
              <p class="font-display font-bold text-4xl text-club-primary-deep mt-1 leading-none tabular-nums">
                {gdLabel}
              </p>
              <p class="text-xs text-club-muted mt-2">{us.gf ?? 0} : {us.ga ?? 0}</p>
            </div>
          </>
        )}
        {leader && (
          <div class="bg-white border border-club-border rounded-lg p-4 md:p-5">
            <p class="text-[11px] font-display uppercase tracking-widest text-club-muted">
              {leaders.length > 1 ? "Najbolji strijelci" : "Najbolji strijelac"}
            </p>
            <p class="font-display font-bold text-lg text-club-primary-deep mt-1 leading-tight">
              {leaders.length > 2 ? (
                `${leaders.length} igrača`
              ) : leaderHref && leaders.length === 1 ? (
                <a href={leaderHref} class="hover:text-club-primary hover:underline">{leader.name}</a>
              ) : (
                leaders.map((l) => l.name).join(", ")
              )}
            </p>
            <p class="text-xs text-club-muted mt-2">
              {`${topGoals} ${golLabel(topGoals)} · ${scope}`}
            </p>
          </div>
        )}
      </div>
    </section>
  )
}
