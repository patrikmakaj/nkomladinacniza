---
import hns from "../data/hns.json";
import { crestSrc } from "../lib/images";
import { url } from "../lib/url";
import type { LeagueRow } from "../lib/matches";

interface Props {
  /**
   * Sažeta tablica za naslovnicu: prvak, pa naš red s dvije ekipe iznad i
   * ispod (i sljedeći protivnik ako je izvan toga). Ostali redovi su u HTML-u,
   * samo skriveni — gumb ispod ih otvara na mjestu. Cijela seniorska tablica
   * nema svoju stranicu, pa se ne smije izgubiti.
   */
  compact?: boolean;
  /** Redovi ljestvice; bez ovoga se koristi seniorska liga. */
  rows?: LeagueRow[];
  /** Naziv natjecanja (caption za čitače ekrana); bez ovoga seniorska liga. */
  title?: string;
  /** id kluba koji se ističe kao sljedeći protivnik. */
  highlightId?: number | null;
}

const { compact = false, rows, title, highlightId = null } = Astro.props;

const fullTable: LeagueRow[] = rows ?? hns.table;
const competitionName = title ?? hns.competition?.name ?? "Tablica lige";

// Koji redovi se vide u sažetom prikazu (indeksi u fullTable).
const WINDOW = 5;
const n = fullTable.length;
const isCompact = compact && n > WINDOW + 2;
const visible = new Set<number>();
if (isCompact) {
  const usIdx = fullTable.findIndex((t) => t.isUs);
  const centre = usIdx >= 0 ? usIdx : 0;
  const start = Math.max(0, Math.min(centre - 2, n - WINDOW));
  for (let i = start; i < start + WINDOW; i++) visible.add(i);
  visible.add(0);
  const nextIdx = highlightId != null ? fullTable.findIndex((t) => t.club.id === highlightId) : -1;
  if (nextIdx >= 0) visible.add(nextIdx);
}
const shown = (idx: number) => !isCompact || visible.has(idx);
/** Prije vidljivog reda kojem prethodni red nije vidljiv ide "···". */
const gapBefore = (idx: number) => isCompact && idx > 0 && shown(idx) && !shown(idx - 1);

// Oznaka uz ime (ne samo boja) — vidi se i bez razlikovanja boja.
const isNext = (row: LeagueRow) =>
  highlightId != null && !row.isUs && row.club.id === highlightId;
---

<div class="bg-white rounded-lg shadow-md overflow-hidden border border-club-border" data-league-table>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">{competitionName}</caption>
      <thead class="bg-club-secondary text-white">
        <tr>
          <th class="px-3 py-3 text-left font-display uppercase tracking-wider text-xs">#</th>
          <th class="px-3 py-3 text-left font-display uppercase tracking-wider text-xs">Klub</th>
          <th class="px-2 py-3 text-center font-display uppercase tracking-wider text-xs">U</th>
          <th class="px-2 py-3 text-center font-display uppercase tracking-wider text-xs hidden sm:table-cell">P</th>
          <th class="px-2 py-3 text-center font-display uppercase tracking-wider text-xs hidden sm:table-cell">N</th>
          <th class="px-2 py-3 text-center font-display uppercase tracking-wider text-xs hidden sm:table-cell">I</th>
          <th class="px-2 py-3 text-center font-display uppercase tracking-wider text-xs hidden md:table-cell">GZ:GP</th>
          <th class="px-3 py-3 text-center font-display uppercase tracking-wider text-xs">B</th>
        </tr>
      </thead>
      <tbody>
        {
          fullTable.map((row, idx) => {
            return (
              <>
                {gapBefore(idx) && (
                  <tr data-table-gap aria-hidden="true">
                    <td colspan="8" class="text-center text-club-muted text-xs py-1 bg-club-light-2 tracking-[0.3em]">···</td>
                  </tr>
                )}
                <tr
                  data-table-extra={shown(idx) ? undefined : ""}
                  style={shown(idx) ? undefined : "display: none"}
                  class={`border-b border-club-border ${
                    row.isUs
                      ? "bg-club-primary/10 font-bold"
                      : isNext(row)
                        ? "bg-club-accent/15"
                        : idx % 2 === 0
                          ? "bg-white"
                          : "bg-gray-50"
                  }`}
                >
                  <td class="px-3 py-3 font-display">{row.position}</td>
                  <td class="px-3 py-3">
                    <div class="flex items-center gap-2">
                      {row.club.logo && (
                        <img
                          src={crestSrc(row.club.logo)}
                          alt=""
                          width="24"
                          height="24"
                          class="object-contain w-6 h-6 flex-shrink-0"
                          loading="lazy"
                        />
                      )}
                      <span class={row.isUs ? "text-club-primary" : ""}>
                        {row.club.name}
                      </span>
                      {isNext(row) && (
                        <span class="flex-shrink-0 bg-club-accent text-club-primary-deep text-[10px] font-display font-bold uppercase tracking-wider px-1.5 py-0.5 rounded-sm">
                          Sljedeći
                        </span>
                      )}
                    </div>
                  </td>
                  <td class="px-2 py-3 text-center">{row.played}</td>
                  <td class="px-2 py-3 text-center hidden sm:table-cell">{row.wins}</td>
                  <td class="px-2 py-3 text-center hidden sm:table-cell">{row.draws}</td>
                  <td class="px-2 py-3 text-center hidden sm:table-cell">{row.losses}</td>
                  <td class="px-2 py-3 text-center hidden md:table-cell text-club-muted">
                    {row.gf}:{row.ga}
                  </td>
                  <td class="px-3 py-3 text-center font-bold">{row.points}</td>
                </tr>
              </>
            );
          })
        }
      </tbody>
    </table>
  </div>
  {
    isCompact && (
      <button
        type="button"
        data-table-toggle
        aria-expanded="false"
        data-umami-event="Cijela tablica"
        class="w-full flex items-center justify-center gap-1.5 px-4 py-3 text-xs font-display uppercase tracking-widest text-club-primary hover:bg-club-light-2 transition-colors"
      >
        <span data-label-closed>Cijela tablica · {n} klubova</span>
        <span data-label-open style="display: none">Sažeta tablica</span>
        <svg class="w-3.5 h-3.5 transition-transform" data-chevron fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
        </svg>
      </button>
    )
  }
</div>

<script>
  // Otvaranje sažete tablice. Skrivanje ide kroz style.display, ne `hidden`
  // (Tailwind klasa bi ga pregazila). Veže se na astro:page-load zbog View Transitions.
  function setupTables() {
    document.querySelectorAll<HTMLElement>("[data-league-table]").forEach((table) => {
      const toggle = table.querySelector<HTMLButtonElement>("[data-table-toggle]");
      if (!toggle || toggle.dataset.init === "1") return;
      toggle.dataset.init = "1";
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        table.querySelectorAll<HTMLElement>("[data-table-extra]").forEach((r) => (r.style.display = open ? "" : "none"));
        table.querySelectorAll<HTMLElement>("[data-table-gap]").forEach((r) => (r.style.display = open ? "none" : ""));
        toggle.querySelector<HTMLElement>("[data-label-closed]")!.style.display = open ? "none" : "";
        toggle.querySelector<HTMLElement>("[data-label-open]")!.style.display = open ? "" : "none";
        toggle.querySelector<SVGElement>("[data-chevron]")!.style.transform = open ? "rotate(180deg)" : "";
      });
    });
  }
  document.addEventListener("astro:page-load", setupTables);
</script>
