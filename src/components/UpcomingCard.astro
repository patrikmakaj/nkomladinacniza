---
/**
 * Kartica nadolazeće utakmice — par ResultCardu: grb i ime protivnika,
 * natjecanje i dan, desno vrijeme i doma/gosti. Ispod gumbi (kalendar ·
 * upute) i link na najavu.
 *
 * Kalendar ide kroz /utakmica/[id].ics (MatchActions), isti kao na
 * naslovnici — prije je /raspored slagao svoju .ics datoteku u pregledniku,
 * s drukčijim mjestom igranja za istu utakmicu.
 */
import TeamCrest from "./TeamCrest.astro";
import MatchActions from "./MatchActions.astro";
import { url } from "../lib/url";
import { shortDate, todayInZagreb, type UnifiedMatch } from "../lib/matches";

interface Props {
  match: UnifiedMatch;
  /** Natjecanje, npr. "2. ŽNL · 7. kolo" — reže se ako je predugo. */
  label: string;
  /** Link na /najava/[id]; mlađe kategorije ga nemaju. */
  withPreview?: boolean;
  /** Tip natjecanja za filter na /raspored (`data-match-type`). */
  matchType?: string;
}

const { match: m, label, withPreview = false, matchType } = Astro.props;

const opponent = m.isHome ? m.away : m.home;
const opponentName = opponent.name.replace(/^NK\s+/, "");
const weekday = new Date(`${m.date}T12:00:00`).toLocaleDateString("hr-HR", {
  weekday: "short",
  timeZone: "Europe/Zagreb",
});
// .ics se gradi samo za utakmice od danas nadalje; ona kojoj je datum prošao,
// a rezultata još nema, ostaje bez gumba.
const hasActions = m.date >= todayInZagreb;
---

<article data-match-type={matchType} class="bg-white border border-club-border rounded-lg px-4 py-3">
  <div class="flex items-center gap-3">
    <span class="w-9 h-9 flex-shrink-0 flex items-center justify-center">
      <TeamCrest team={opponent} size={36} class="w-full h-full" />
    </span>
    <div class="flex-1 min-w-0">
      <p class="flex gap-1 text-[11px] uppercase tracking-wider text-club-muted whitespace-nowrap">
        <span class="truncate">{label}</span>
        <span class="flex-shrink-0">· {weekday} {shortDate(m.date)}</span>
      </p>
      <p class="font-display font-bold uppercase leading-tight text-club-secondary">{opponentName}</p>
    </div>
    <div class="text-right flex-shrink-0">
      <p class="font-display font-bold text-2xl tabular-nums leading-none text-club-primary-deep">
        {m.time ?? "—"}
      </p>
      <p class="text-[10px] font-display uppercase tracking-wider mt-1 text-club-muted">
        {m.isHome ? "Doma" : "Gosti"}
      </p>
    </div>
  </div>
  {(hasActions || withPreview) && (
    <div class="mt-2 pt-2 border-t border-club-border/60 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
      {hasActions ? <MatchActions match={m} variant="links" /> : <span />}
      {withPreview && (
        <a
          href={url(`/najava/${m.id}`)}
          class="text-xs font-display uppercase tracking-wider text-club-primary hover:underline"
        >
          Najava i forma →
        </a>
      )}
    </div>
  )}
</article>
