---
/**
 * Upis djece u školu nogometa — glavni put do novih igrača.
 *
 * Kontakt je WhatsApp/poziv predsjednika DŠA Niza (dogovoreno s klubom),
 * a ne Facebook: roditelji se brže jave porukom nego kroz Messenger stranice.
 * Podaci su ovdje na jednom mjestu; `compact` je kratka traka za naslovnicu.
 */
import { url } from "../lib/url";

interface Props {
  /** Kratka traka (naslovnica) umjesto punog bloka (/mladje-kategorije). */
  compact?: boolean;
}

const { compact = false } = Astro.props;

const SIGNUP = {
  contactName: "Patrik Makaj",
  contactRole: "predsjednik DŠA Niza",
  phone: "+385912680220",
  phoneDisplay: "091 268 0220",
  minAge: 6,
};

const waText = "Pozdrav! Zanima me upis djeteta u školu nogometa NK Omladinac Niza.";
const waHref = `https://wa.me/${SIGNUP.phone.replace(/\D/g, "")}?text=${encodeURIComponent(waText)}`;
const telHref = `tel:${SIGNUP.phone}`;

const facts = [
  { icon: "🎂", title: `Od ${SIGNUP.minAge} godina`, text: "Primamo djecu od šeste godine — iskustvo nije potrebno." },
  {
    icon: "🌙",
    title: "Utorak i četvrtak",
    text: "Kasno poslijepodne ili navečer, pod reflektorima na Grbavici. Točan termin javljamo na WhatsAppu.",
  },
  { icon: "🎟️", title: "Besplatno", text: "Škola nogometa ne naplaćuje članarinu." },
  { icon: "🥪", title: "Hrana i piće", text: "Nakon svake utakmice za sve igrače." },
  { icon: "👕", title: "Oprema", text: "Ako djetetu nešto od opreme treba, udruga može osigurati." },
];

const waIcon =
  '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>';
---

{
  compact ? (
    <aside class="bg-club-secondary text-white rounded-lg p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
      <div class="flex-1">
        <p class="text-xs font-display uppercase tracking-widest text-club-accent mb-1">Škola nogometa</p>
        <p class="font-display font-bold uppercase text-xl md:text-2xl leading-tight">
          Upis djece od {SIGNUP.minAge} godina — besplatno
        </p>
        <p class="text-sm text-white/75 mt-1">
          Treninzi utorkom i četvrtkom pod reflektorima na Grbavici.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25D366] text-white px-4 py-2.5 rounded font-display font-bold uppercase tracking-wider text-sm hover:brightness-95"
          data-umami-event="Upis WhatsApp"
          data-umami-event-mjesto="naslovnica"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={waIcon} />
          WhatsApp
        </a>
        <a
          href={url("/mladje-kategorije#upis")}
          class="inline-flex items-center px-4 py-2.5 rounded border border-white/40 font-display font-bold uppercase tracking-wider text-sm hover:bg-white/10"
        >
          Više o upisu
        </a>
      </div>
    </aside>
  ) : (
    <section id="upis" class="bg-white border-2 border-club-primary rounded-lg overflow-hidden scroll-mt-24">
      <div class="bg-gradient-to-r from-club-primary-deep to-club-primary text-white px-6 py-5">
        <p class="text-xs font-display uppercase tracking-widest text-club-accent mb-1">Škola nogometa</p>
        <h2 class="text-2xl md:text-3xl text-white">Upis djece</h2>
      </div>

      <div class="p-6 md:p-8">
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {facts.map((f) => (
            <li class="flex gap-3">
              <span class="text-2xl leading-none flex-shrink-0" aria-hidden="true">{f.icon}</span>
              <div>
                <p class="font-display font-bold uppercase text-club-primary-deep">{f.title}</p>
                <p class="text-sm text-club-secondary/80 leading-snug mt-0.5">{f.text}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-8 pt-6 border-t border-club-border flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
          <div class="flex-1">
            <p class="text-sm text-club-muted">Javi se porukom ili pozivom</p>
            <p class="font-display font-bold uppercase text-lg text-club-secondary leading-tight">
              {SIGNUP.contactName}
            </p>
            <p class="text-sm text-club-muted">
              {SIGNUP.contactRole} · <a href={telHref} class="hover:text-club-primary">{SIGNUP.phoneDisplay}</a>
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[#25D366] text-white px-5 py-3 rounded font-display font-bold uppercase tracking-wider text-sm hover:brightness-95"
              data-umami-event="Upis WhatsApp"
              data-umami-event-mjesto="mladje-kategorije"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={waIcon} />
              Pošalji poruku
            </a>
            <a
              href={telHref}
              class="inline-flex items-center gap-2 border-2 border-club-primary text-club-primary-deep px-5 py-3 rounded font-display font-bold uppercase tracking-wider text-sm hover:bg-club-primary hover:text-white transition-colors"
              data-umami-event="Upis poziv"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Nazovi
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}
